# Example environment variables for Content Growth Agent

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
LLM_PROVIDER=openai
LLM_MODEL=gpt-4

# Memory (MVP uses in_memory)
MEMORY_TYPE=in_memory
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://user:password@localhost/dbname

# App
LOG_LEVEL=INFO
DEBUG=false

# YouTube/Instagram API keys if needed
YOUTUBE_API_KEY=
INSTAGRAM_COOKIE=

# Streamlit
STREAMLIT_SERVER_PORT=8501
