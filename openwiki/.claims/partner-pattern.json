    {
      "id": "claim_7c2a1600fd294471a122d693305b38f8",
      "statement": "The _BUILTIN_PROVIDERS dictionary in init_chat_model maps provider names to module paths, class names, and instantiation functions, enabling dynamic import and instantiation of chat model integrations by name. Adding a provider requires registering a tuple of (module_path, class_name, creator_func) for each entry.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L56-L99",
          "version": "repo-lines-v1:sha256:a0432456fbcc294961073b737c0871eb2e1444b6649f4f39c8fd5af7d29f8834:"
        }
      ]
    },
    {
      "id": "claim_ede1719006f44fd88e9ed6a867a79850",
      "statement": "All chat model providers must inherit from BaseChatModel and implement _generate method (required for sync generation) and optionally _stream method for streaming support. _agenerate and _astream are async variants. The _llm_type property identifies the provider.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L284-L2400",
          "version": "repo-lines-v1:sha256:cdf77a3db35dd154ae26e7d5825099290e4a9d5499a0b0abe672652de89234a6:"
        },
        {
          "resource": "repo://libs/partners/anthropic/langchain_anthropic/chat_models.py#L1-L150",
          "version": "repo-lines-v1:sha256:47a04bd87a92b9037d3179b7287d4784fac7ed8aa57086c7024802ee055bc298:"
        }
      ]
    },
    {
      "id": "claim_ec81f5b4f21b4f2480ccacc8d1fd3ce9",
      "statement": "Provider implementations translate between LangChain's unified message format with content blocks (text, images, tool_calls, etc.) and provider-specific API schemas. This occurs in _generate/_stream before calling the provider API and when parsing responses into AIMessage/AIMessageChunk.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/messages/base.py#L93-L180",
          "version": "repo-lines-v1:sha256:e6be22558dc63e5340eb68ee9c6fd5e038ce8e73a744032231edf160bf532c1f:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L250-L280",
          "version": "repo-lines-v1:sha256:686c23b74e32457db00c2e583377c31832bd2a88f13e64efdf991f0c601285c6:"
        }
      ]
    },
    {
      "id": "claim_abb3b526d5bf49b19dd0d5aaf8c8b6f0",
      "statement": "Streaming _stream method yields ChatGenerationChunk objects containing AIMessageChunk with incremental content tokens. It enables streaming in the API request, iterates provider events, extracts deltas, and calls run_manager.on_llm_new_token for observability.",
      "evidence": [
        {
          "resource": "repo://libs/partners/anthropic/langchain_anthropic/chat_models.py#L1862-L1910",
