    {
      "id": "claim_ae44c1b200d14618acc3f4b493058651",
      "statement": "During streaming, the callback lifecycle fires on_chat_model_start at initiation, on_llm_new_token for each chunk (passing token string/content blocks, full chunk object, run_id, parent_run_id, and tags), accumulates chunks in memory, and fires on_llm_end with merged result on success or on_llm_error with partial accumulation on failure. LangSmith automatically captures this lifecycle for token-level observability.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/callbacks/base.py#L65-L88",
          "version": "repo-lines-v1:sha256:e4bed7227dc627f01db18cbf919a34691f2f85f4e0b4ead3a90c7dc43ae5f17e:"
