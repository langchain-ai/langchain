    {
      "id": "claim_f053f61bfe474e17864760dbb4513d25",
      "statement": "RunnableSequence chains stream end-to-end only if all components implement transform(). Components without transform() act as blocking points where the stream waits for completion before resuming. Multiple blocking components create multiple buffering points. RunnableLambda is a blocking component by default; custom streaming logic requires subclassing Runnable and overriding transform().",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L1194-L1235",
          "version": "repo-lines-v1:sha256:52f3933957d94c8162dfa849e70cd335d61247108917a8fb081a31fe43b0f570:"
        },
        {
