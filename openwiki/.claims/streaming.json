          "version": "repo-lines-v1:sha256:ad25efc0b9dde129f68999de4a00b228f4ebcdb5e3c41d1f5d86a71690598a81:"
        }
      ]
    },
    {
      "id": "claim_3e0ace0e9ef84daea2fc4361e21843fb",
      "statement": "The _compat_bridge module converts streams of AIMessageChunk chunks into a structured protocol event lifecycle. The bridge tracks blocks by source-side identity (block index), assigns sequential wire-level uint indices, emits content-block-delta events for per-chunk deltas, and accumulates state for content-block-finish events. Core APIs are chunks_to_events() / achunks_to_events() for live streams and message_to_events() / amessage_to_events() for replaying finalized AIMessage objects.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L1-L50",
          "version": "repo-lines-v1:sha256:d5047e25e13e143201fd85d28e1be7cc09ae544911fb5ecbc3d3cd97d34b2de5:"
        },
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L596-L701",
          "version": "repo-lines-v1:sha256:411b3b7ab479be7cb8ab659e73eaf3977f0f34c7e6f80c219b22d889b7f34263:"
        }
      ]
    },
    {
      "id": "claim_8bcc007f058d4225a1f97a7c8bfab3cc",
      "statement": "The protocol event lifecycle is: message-start (once, with provider metadata) -> content-block-start (per new source block index) -> content-block-delta* (per chunk carrying delta slice) -> content-block-finish (after all chunks, carrying finalized state). Protocol events are MessagesData TypedDicts carrying event type, index, content blocks, usage, and metadata. Message-finish fires once at stream end with accumulated usage and response metadata.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L17-L32",
          "version": "repo-lines-v1:sha256:46b4e836dfd3160e8148e7fa7a1def1d4ea4a0a7f9357ecf283c4abd5af6165b:"
        },
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L536-L589",
          "version": "repo-lines-v1:sha256:d8a84626c1d87464d2283befbd6ba9af09282aac9206c39f1d3007d63018d9d3:"
        }
      ]
    },
    {
      "id": "claim_c35232696791463f98665cc0d067178b",
      "statement": "The finalize_tool_call_chunk() function promotes incomplete tool_call_chunk blocks to finalized tool_call blocks by parsing accumulated argument JSON. On successful JSON parse, it emits a tool_call block with parsed args dict. On JSON parse failure, it emits an invalid_tool_call block carrying the raw string and error message, allowing downstream consumers to introspect malformed payloads.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L365-L427",
          "version": "repo-lines-v1:sha256:ebe93c9b98f8550fbde2e30d7761b29ff161a4b81bca34dac89d88f62bca527c:"
        },
        {
          "resource": "repo://libs/core/tests/unit_tests/language_models/test_compat_bridge.py#L56-L82",
          "version": "repo-lines-v1:sha256:ed7e6e070088ccb621d4226f2ce6d3e301fa7eb999f1cad30de4764ccf5d0c38:"
        }
      ]
    },
    {
      "id": "claim_7fa453abf47344d79f200e3e78190753",
      "statement": "ChatModelStream (returned by stream_events(version='v3')) exposes typed projection properties: .text (SyncTextProjection) for text deltas, .tool_calls (SyncProjection) for tool call chunks, .reasoning for reasoning blocks, .usage for token usage, and .output (AIMessage) for the assembled message. Each projection implements pull-based backpressure via _request_more() callback, allowing consumers to pace the producer and preventing unbounded memory growth.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_model_stream.py#L556-L610",
          "version": "repo-lines-v1:sha256:e0ccd4000335d48f98589212a934a517188c6fdfab80f3572c072b681cf763e3:"
        }
      ]
    },
    {
      "id": "claim_e1ea55c0c8624bcb91d1ef3b7f96779d",
      "statement": "ChatModelStream.dispatch(event) routes protocol events to internal handlers: message-start pushes to _push_message_start(), content-block-delta to _push_content_block_delta(), content-block-finish to _push_content_block_finish(), message-finish to _finish(). Dispatch accumulates state (text per block, tool calls, usage) and completes projections when message-finish arrives, assembling an AIMessage from finalized blocks.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_model_stream.py#L663-L684",
          "version": "repo-lines-v1:sha256:3c2ac26074eb0a33a62e1527ce5358e531aeded4ce79ba61cee119d170b3849a:"
        },
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_model_stream.py#L978-L1030",
          "version": "repo-lines-v1:sha256:a9c2060a434b7cd714a6f669139ebcabde1f115550cca187cc422981d2118c83:"
        }
      ]
    },
    {
      "id": "claim_5e36a3b567c64ccbbc7bbd461ea3ff5b",
      "statement": "Protocol content-block-delta events carry structured delta types: text-delta ({type: 'text-delta', text: '...'}), reasoning-delta ({type: 'reasoning-delta', reasoning: '...'}), data-delta for binary/modal payloads, and block-delta for tool-call-chunk fields. Text and reasoning deltas accumulate per block; tool call and data deltas are finalized at content-block-finish.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/_compat_bridge.py#L118-L143",
          "version": "repo-lines-v1:sha256:112f02065a02908e09798bcb7c20a5e245e8f4dfaf8dbd5912174839dd11a920:"
        }
