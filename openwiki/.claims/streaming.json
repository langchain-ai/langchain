    {
      "id": "claim_19041bc7ad72420d8e1a5087d5713bff",
      "statement": "Message chunk types (AIMessageChunk, HumanMessageChunk, SystemMessageChunk, ToolMessageChunk) represent partial message updates during streaming and all support merging via the + operator. AIMessageChunk specifically includes tool_call_chunks for incomplete tool calls and chunk_position sentinel for stream completion signaling.",
