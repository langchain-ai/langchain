  "claims": [
    {
      "id": "claim_87d5d462354440a7bccb6dbe992c60d3",
      "statement": "BaseChatModel.stream() yields AIMessageChunk objects as they are produced, checking streaming support via _should_stream() and falling back to invoke() if not supported. It manages the callback lifecycle: on_chat_model_start at initiation, on_llm_new_token per chunk, and on_llm_end or on_llm_error at completion. A final empty chunk with chunk_position='last' is yielded to signal stream completion and finalize tool call chunks.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L727-L856",
          "version": "repo-lines-v1:sha256:8945f395d5d6b5430e498ed34a1247f6be3a49e373131a158b3edee84db49a81:"
        }
      ]
    },
    {
      "id": "claim_6325590438b0489892a1599786f86f7e",
      "statement": "BaseChatModel.astream() is the async variant of stream(), mirroring synchronous logic but using async/await for callbacks and AsyncCallbackManager. It iterates via async for over self._astream() and acquires rate limits asynchronously.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L858-L991",
          "version": "repo-lines-v1:sha256:807ccf05f7bff67ca424c7f8b240e4b0317145e74e2c5c57b3d8f788617b6923:"
        }
      ]
    },
    {
      "id": "claim_47e4c9d9b94f4ac78098ea9e0dba4925",
      "statement": "AIMessageChunk represents partial, incremental message updates during streaming. It includes content (token or delta), tool_call_chunks (incomplete tool calls), and chunk_position sentinel. Chunks merge via the + operator, combining content and tool call arguments; the 'last' chunk_position triggers finalization of tool calls into complete ToolCall objects.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/messages/ai.py#L418-L536",
          "version": "repo-lines-v1:sha256:c5c0e4e8c4ad9520a3725d13342d059511e117c85a00f583fd69aa75b13b2bb9:"
        }
      ]
    },
    {
      "id": "claim_eb8e4cb924c441dd91f783e4366a299f",
      "statement": "The on_llm_new_token callback fires for each token or chunk during streaming, receiving the token string (or content block list for v1 format), the full ChatGenerationChunk with metadata and tool_call_chunks, run_id for tracing, and optional parent_run_id and tags. It enables real-time observation, logging, and application-specific reactions to streaming tokens.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/callbacks/base.py#L65-L88",
          "version": "repo-lines-v1:sha256:e4bed7227dc627f01db18cbf919a34691f2f85f4e0b4ead3a90c7dc43ae5f17e:"
        },
        {
          "resource": "repo://libs/core/langchain_core/callbacks/streaming_stdout.py#L50-L60",
          "version": "repo-lines-v1:sha256:eefb74b5ea9fce9d2141392376bb51d0941bb80972240b0e1c64ea016255ed32:"
        }
      ]
    },
    {
      "id": "claim_aff42106f80849fabc5d804cd0fbcff7",
      "statement": "Runnable.stream() by default yields one full output from invoke(). Subclasses that support streaming override stream() or transform() to yield chunks. Streaming is not guaranteed for arbitrary Runnables unless explicitly implemented.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L1194-L1235",
          "version": "repo-lines-v1:sha256:52f3933957d94c8162dfa849e70cd335d61247108917a8fb081a31fe43b0f570:"
        }
      ]
    },
    {
      "id": "claim_fe26c149726c47dfa995e7b3ddafd04f",
      "statement": "RunnableSequence (a chain created with the | operator) automatically supports streaming if all components implement transform() or the last component streams. If any component lacks transform(), streaming is blocked until that component completes. Multiple blocking components create buffering points but preserve streaming output from the last component.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L3075-L3320",
          "version": "repo-lines-v1:sha256:ad25efc0b9dde129f68999de4a00b228f4ebcdb5e3c41d1f5d86a71690598a81:"
        }
      ]
    },
    {
      "id": "claim_694f1031f2f64dfdb7673a21f795434e",
      "statement": "The _transform_stream_with_config() helper manages streaming with callbacks: it tees input iterators for tracing, fires on_chain_start, invokes the transformer function with streaming input, accumulates outputs, yields chunks immediately, and fires on_chain_end or on_chain_error at completion. This is the core machinery for streaming through Runnables in a chain.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L2502-L2599",
          "version": "repo-lines-v1:sha256:b4db1de783dda022373ec076b06a6fc67d0a8abca8fba21251eeeef2822d5116:"
        }
      ]
    },
    {
      "id": "claim_0888246b7f1c4834a3af1a55fc2f1009",
      "statement": "invoke() waits for the entire model response before returning, consuming no intermediate memory but blocking responsiveness. stream() yields the first token as soon as available, enabling real-time feedback in interactive applications. The model produces tokens at the same rate in both cases; the difference is when tokens are delivered to the caller.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L474-L856",
          "version": "repo-lines-v1:sha256:18b246d4f9105712e54309d31157eca8caf0cf172c8c99b1e0a1b8d2d6111527:"
        }
      ]
    },
    {
      "id": "claim_b15ce025491a4425b4d7ee2dc533063a",
      "statement": "During streaming, if an error occurs after on_chat_model_start fires, on_llm_error receives the exception and a ChatGeneration merged from accumulated chunks. The exception is then re-raised. This allows callbacks to observe partial results before failure.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L833-L856",
          "version": "repo-lines-v1:sha256:1c19e5928299e042429af5deae6b48b2c15aa0d928987771b51003c4f8b8b683:"
        }
      ]
    },
    {
      "id": "claim_6019aef1fe5d4c46b2d814b6739259f9",
      "statement": "BaseChatModel.stream_events(version='v3') returns ChatModelStream, which exposes typed projection properties (.text, .tool_calls, .usage, .reasoning, .output) that accumulate protocol events. This is distinct from token streaming and fires on_stream_event callbacks for each protocol event, providing detailed event-level visibility into streaming operations.",
