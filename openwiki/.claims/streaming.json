    {
      "id": "claim_d2c55602420240ce8c4788a0b0cc9dc2",
      "statement": "Token-level streaming occurs at granularity finer than complete messages: individual token strings or content block deltas are yielded per chunk, tool call arguments accumulate across chunks with incremental JSON parsing via parse_partial_json(), and callbacks observe partial state at each step. This enables real-time visibility into token generation and tool invocation without waiting for completion.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/callbacks/base.py#L65-L88",
          "version": "repo-lines-v1:sha256:e4bed7227dc627f01db18cbf919a34691f2f85f4e0b4ead3a90c7dc43ae5f17e:"
