        }
      ]
    },
    {
      "id": "claim_032b850893174b9a962418ae43d05154",
      "statement": "Agents created via create_agent() support streaming via stream_events(version='v3'), exposing projections for tool_calls (registered by ToolCallTransformer), output_deltas (streamed via runtime.emit_output_delta()), messages (from MessagesTransformer), and subgraphs (registered by SubagentTransformer for hierarchical agents). ToolCallTransformer and SubagentTransformer are registered by default on the compiled graph, and user-supplied transformers are appended after built-in ones.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1909-L1925",
          "version": "repo-lines-v1:sha256:2c016bc18341021900d265969249afc0a0b398d1a9979f911f039a224309512c:"
