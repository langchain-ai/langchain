    {
      "id": "claim_bc0f38340eb849dfb18cbd2b40fc4715",
      "statement": "The add_ai_message_chunks() function merges multiple AIMessageChunk objects by concatenating content, appending tool call argument strings, summing usage metadata, preserving chunk_position='last' sentinel, and selecting the best message ID by rank (provider-assigned > LC_run_* > LC_*). When merged chunks include chunk_position='last', the init_tool_calls validator finalizes tool_call_chunks into complete tool_calls.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/messages/ai.py#L508-L568",
          "version": "repo-lines-v1:sha256:004637120d5e7dd5227e2b491832ad9b05ac3e0e6390cf056d01eb954363ff38:"
