        }
      ]
    },
    {
      "id": "claim_34eeb5e8e3344e26a1e37281f9952010",
      "statement": "ModelRequest provides an immutable override() method allowing middleware to create new requests with modified fields: model, system_message, messages, tools, tool_choice, response_format, model_settings, and state. This enables middleware to customize the model call without mutations, preserving request immutability.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L203-L269",
          "version": "repo-lines-v1:sha256:3520f1a6407e8d83c81bea4d581ee001e23d77d2ee4924010e0be9f88a273643:"
        }
      ]
    },
    {
      "id": "claim_39161d31555a4c48a22ee8c8c5036165",
      "statement": "create_agent constructs a StateGraph with conditional edges for routing: model -> tools (if tool_calls), tools -> model (loop) or end (if return_direct), or model -> end (no tools/no calls). Entry point is before_agent if present, else before_model if present, else model. Loop entry/exit points can be adjusted by middleware before_model/after_model hooks. Exit point is after_agent if present, else END.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1715-L1810",
          "version": "repo-lines-v1:sha256:ea83473ebc1f2c38614936843c7ce7d3baf0b26d9fcb91f2fafb840f1990ed98:"
