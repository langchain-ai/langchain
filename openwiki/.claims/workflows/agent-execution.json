  "claims": [
    {
      "id": "claim_0240415bda374dfcaaea98d68fe5e7b4",
      "statement": "AgentState is a TypedDict defining agent execution state with three fields: `messages` (required, merged via add_messages reducer), `jump_to` (ephemeral routing hint), and `structured_response` (optional parsed output). The state persists across the agentic loop and middleware can extend it via state_schema parameter.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1226-L1234",
          "version": "repo-lines-v1:sha256:79c59a206dc67c41cff7e2895b104673b0bf154adb4e716a7f0eb051aa756b95:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L349-L354",
          "version": "repo-lines-v1:sha256:c995df23d29c623277091b5c9a18504b94c75d83702467cccbe504b1ac99b777:"
        }
      ]
    },
    {
      "id": "claim_e9becf91bbb04daf87e6bd3f5c826a16",
      "statement": "create_agent() is the primary factory for constructing agents. It accepts a model (string or BaseChatModel), tools (BaseTool, callables, or dicts), optional system_prompt, middleware list, response_format, and execution configuration (checkpointer, store, debug). It returns a CompiledStateGraph that supports both sync (invoke/stream) and async (ainvoke/astream) execution.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L892-L1045",
          "version": "repo-lines-v1:sha256:95ec9d7e14e22e1dc6f068eaa3246a9290e730715df1cd510e1445b1b17cd69d:"
        }
      ]
    },
    {
      "id": "claim_19dfb5cf4c7c40ffa30593bc569f2323",
      "statement": "AgentMiddleware instances are composed in first-in-outermost order: middleware[0] wraps all others for request flow. Middleware can implement node hooks (before_agent, after_agent, before_model, after_model) for state updates or handler wrappers (wrap_model_call, wrap_tool_call) for intercepting and controlling core operations. Multiple middleware compose automatically through the graph's node structure.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1163-L1225",
          "version": "repo-lines-v1:sha256:c89e2a0d92375c9e3b22ba768d36b7d8a289ad55788a75ee0ab593ec6cb8e402:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L385-L820",
          "version": "repo-lines-v1:sha256:425c570a3a7cb333dd22290a35fc498f28d24690b8017784ee6dd5b8157a4bf1:"
        }
      ]
    },
    {
      "id": "claim_cdf1063180ae4a46a17ec2e5af4b296c",
      "statement": "wrap_model_call(request, handler) intercepts model execution. The handler callback executes the model and returns ModelResponse. Middleware can call handler multiple times (retry), skip it (short-circuit), modify request (tools, system message), or rewrite response. Returns ModelResponse, AIMessage (auto-converted), or ExtendedModelResponse (with optional Command for state updates).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L281-L370",
          "version": "repo-lines-v1:sha256:272c0933c5414b8cecc2e64643c365fa65e76088a91d385cdab443f37076f035:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L503-L585",
          "version": "repo-lines-v1:sha256:e2e85f065ac582ee3ff2cb0d26be437d93267a1340f230c025f69dbd634d5ef3:"
        }
      ]
    },
    {
      "id": "claim_a05ba4f1fafd44c2ac0fa9d8930ee3a1",
      "statement": "wrap_tool_call(request, handler) intercepts tool execution. The handler callback executes the tool and returns ToolMessage or Command. Middleware can call handler multiple times (retry), validate arguments before execution, monitor usage, or mock tools. Each handler invocation is independent and stateless.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L710-L819",
          "version": "repo-lines-v1:sha256:1677288ee20a0766e557ca59564e1c8af0dc7b6d2c6938d2e2eb36771f4833be:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L674-L754",
          "version": "repo-lines-v1:sha256:e2f4db971fce16b3edf6a11c580348522490c1b4f0e76525ca8359cc244444af:"
        }
      ]
    },
    {
      "id": "claim_6d5821fe67004601a52b1ce00cd9bc6a",
      "statement": "The agent loop has three core phases executed in sequence: (1) Model Node calls language model with messages and tools, returning AIMessage with optional tool_calls; (2) Tools Node executes tool calls via ToolNode, returning ToolMessage results; (3) Routing decides whether to loop back (more tools), skip tools (structured output), or terminate (no tool calls). Middleware hooks intercept at each phase.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1520-L1608",
          "version": "repo-lines-v1:sha256:3671052586382011e014a6d60493d804ee6b77d3628034c4ba96e87301ce4b14:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1743-L1811",
          "version": "repo-lines-v1:sha256:c2cce51192a0295f157a702a058956aae56f4eb5bbd1b0042e1e334e09c35e44:"
        }
      ]
    },
    {
      "id": "claim_463389e9542f45c98a8b96c9cac7c3a1",
      "statement": "create_agent binds tools to the model via model.bind_tools(). Tools can be BaseTool instances, Python callables (auto-wrapped), or dict schemas (provider built-ins). The factory creates a ToolNode when tools are provided, which validates tool names, executes tools, applies middleware wrappers, and returns ToolMessage results. Invalid tool calls are automatically patched with error messages.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L1129-L1157",
          "version": "repo-lines-v1:sha256:978653217698fe353834f511fb796c0d721f99c88522baeca72a4c53776f20a4:"
