        }
      ]
    },
    {
      "id": "claim_e4b6c042609c4f07a6f70955179b92be",
      "statement": "ProviderStrategyBinding wraps provider-native structured output response parsing by extracting text content from AIMessage, parsing JSON via json.loads(), and validating against schema using _parse_with_schema(). It raises ValueError on JSON parsing or schema validation failures, without automatic retry (provider enforces schema).",
