    {
      "id": "claim_97c287d243e74111afde72c93e9983a1",
      "statement": "BaseOutputParser is the abstract base class for all output parsers, inheriting from RunnableSerializable to provide sync (invoke), async (ainvoke), batch, and streaming execution. Every parser must implement parse_result() to transform Generation objects into validated structured output of type T, raising OutputParserException on invalid input.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/output_parsers/base.py#L140-L170",
          "version": "repo-lines-v1:sha256:59bb6901f0c851d877f9ca909a1be14d8d92e00d62b9c960664a74b537816e0f:"
        }
      ]
    },
    {
      "id": "claim_39d5737c45f84c4b952c8bb19b78f828",
      "statement": "with_structured_output() is a method on BaseChatModel that wraps a model to enforce structured output by leveraging the model provider's native capabilities. It accepts Pydantic models, TypedDict classes, JSON schema dicts, or OpenAI function schemas, and returns a Runnable that outputs instances of the schema type (validated) or dicts (unvalidated). The include_raw parameter controls whether to return only parsed output or also raw response and parsing errors.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L2385-L2565",
          "version": "repo-lines-v1:sha256:673bc22e396265b7dbabfa67b802837132337352be622cd69c071cfc5dfd1c84:"
        }
      ]
    },
    {
      "id": "claim_9750d6fac44340908735d0cb9d28d771",
      "statement": "PydanticOutputParser parses JSON-formatted text output from a model into a Pydantic model instance by extracting JSON from markdown, validating against the schema, and returning a validated instance or raising OutputParserException. It provides get_format_instructions() to generate prompts that guide models to produce JSON conforming to a schema.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/output_parsers/pydantic.py#L19-L124",
          "version": "repo-lines-v1:sha256:a588180fc4e69f457c9e46cdda957c771911d19c74dfaee25ae02b86313e9421:"
        }
      ]
    },
    {
      "id": "claim_9aff4bf66f1341c7a95b787b83649bf9",
      "statement": "JsonOutputParser parses JSON output without strict schema validation and extends BaseCumulativeTransformOutputParser to support streaming. In streaming mode, it accumulates text chunks and yields partial JSON objects containing all keys returned so far, or optionally JSONPatch diffs if diff=True.",
      "evidence": [
