    {
      "id": "claim_2cfbfc0796aa4bb98fe7a602880236dc",
      "statement": "Runnables are generic over input and output types (Runnable[Input, Output]). Input/output schemas are inferred from generic parameters or function signatures, exposed via input_schema and output_schema properties, and used for validation and tooling.",
