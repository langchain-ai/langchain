    {
      "id": "claim_32c33225b83e41ce908d4108ef10a396",
      "statement": "RunnableParallel invokes multiple Runnables concurrently with the same input, collecting results into a dict. A dict literal in a sequence is automatically coerced to RunnableParallel. Execution uses thread pool for sync and asyncio.gather for async, with max_concurrency config limiting parallelism.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L3868-L3950",
          "version": "repo-lines-v1:sha256:51a7d6b77803d9585e4f749ba8bcd2a3b2e403611c448b758555156df662e148:"
        }
