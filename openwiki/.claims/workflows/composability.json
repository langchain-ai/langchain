    },
    {
      "id": "claim_f10c35a143cd41d69d2702acd137df82",
      "statement": "The pipe operator (|) creates RunnableSequence, chaining Runnables sequentially where each output becomes the next input. It automatically flattens nested sequences and coerces callables and dicts to Runnables, enabling inline composition.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L3079-L3235",
          "version": "repo-lines-v1:sha256:9e17c9b4d22b465eb4fe938622668409ee9d6c526c045b1b81b976345954edad:"
