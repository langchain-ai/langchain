          "version": "repo-lines-v1:sha256:1701e229b7791d8499564f4176d923f5f42f0c062c3983d2a1bbbd6828f80f52:"
        }
      ]
    },
    {
      "id": "claim_9bda2ead2c7f45a3b99cdaafcd6173c2",
      "statement": "Middleware registered on an agent forms an independent stack where first-in becomes outermost layer. Middleware does not automatically propagate across agent boundaries; to share behavior across coordinator and specialist agents, wrap tool functions with error handling, use context-aware middleware that reads runtime.context, or implement per-level middleware aligned with agent responsibilities.",
      "evidence": [
        {
