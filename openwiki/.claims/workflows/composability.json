    },
    {
      "id": "claim_8b467fe337b24da2881bfd58328492a6",
      "statement": "RunnableBranch routes execution to one of multiple branches based on sequential condition evaluation. The first condition returning True selects its branch; if none match, the default branch executes. Conditions can be sync, async, or awaitable callables returning bool.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/branch.py#L43-L290",
          "version": "repo-lines-v1:sha256:77b53fbabf2bdae2e052b15b90650cf13e0e2d73221231eb5f782f4a5b5445ed:"
        }
      ]
    },
    {
      "id": "claim_1871af27b9594dc287f334e9c8c92533",
      "statement": "RunnableWithFallbacks tries a primary Runnable, then fallbacks in order until one succeeds. It catches exceptions matching exceptions_to_handle, optionally injects exceptions into fallback input via exception_key, and tracks per-input success in batch mode.",
