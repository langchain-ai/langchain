    {
      "id": "claim_fbbb3b3174e64269bf54641648c86584",
      "statement": "SubagentTransformer detects hierarchical agent boundaries when a tool function invokes create_agent(name=...) that differs from the parent's lc_agent_name. On boundary detection, it creates a typed SubagentRunStream or AsyncSubagentRunStream handle on run.subagents, tracks the originating tool call as a causation edge via the cause property, and forwards child events into an isolated mux for independent consumption.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/_subagent_transformer.py#L1-L82",
          "version": "repo-lines-v1:sha256:7a22ce25db41f0ca1e8e362100824869d2c1d4892d860c8c4654f40b29abd170:"
        },
        {
