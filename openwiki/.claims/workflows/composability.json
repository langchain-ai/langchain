          "version": "repo-lines-v1:sha256:c871566dc1a1a630ebd27fdd9d23437044f3360ad6bc0ccafcde71967cb6d6c4:"
        }
      ]
    },
    {
      "id": "claim_4c077e41b68b4c9f9d0eeaeef1f39a6e",
      "statement": "Hierarchical agent systems in LangChain compose through tool-based delegation: specialist agents (leaf nodes) implement domain-specific logic; coordinator agents (middle nodes) route queries via tool invocation; supervisor agents (root) maintain user context. Each agent has an isolated middleware stack; behavior propagation across levels requires explicit handling via tool wrappers, context passing, or runtime.context.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/_subagent_transformer.py#L44-L118",
          "version": "repo-lines-v1:sha256:fefaebe537c1019b6bae92e7c5c0f41edeccee836c15a394d38166badace9e7c:"
        }
      ]
    },
    {
      "id": "claim_1cfd944083d7476082bff65f3d60a5dd",
      "statement": "Subagent events can be streamed independently via stream_events(version=\"v3\"). SubagentRunStream exposes name (the nested agent's lc_agent_name), cause (the tool call that triggered it as {\"type\": \"toolCall\", \"tool_call_id\": ...}), status (success/failed/timeout), and error (failure message). This enables end-to-end tracing and causation tracking across hierarchies.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/_subagent_transformer.py#L44-L82",
          "version": "repo-lines-v1:sha256:00f094b6ca965e53536d72288f1c813f1242473aeb4759adf4f25cbb1b7acb94:"
        },
        {
