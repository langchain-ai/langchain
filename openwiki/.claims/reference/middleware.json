    {
      "id": "claim_35901c1c931949a2a25fc6cda20bc87b",
      "statement": "@dynamic_prompt is a convenience decorator that creates middleware using wrap_model_call specifically for dynamic system prompt generation. The decorated function receives a ModelRequest and returns a string or SystemMessage that replaces the system message before model invocation. Both sync and async functions are supported.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L1689-L1842",
          "version": "repo-lines-v1:sha256:59cfa144fe863aaebd07ef071f6ac615f4ea94efcfa83bb8ef21aa406c4268e3:"
        }
      ]
    },
    {
      "id": "claim_3acda7934e884794954a19c5b1ec2019",
      "statement": "@wrap_model_call and @wrap_tool_call decorators create middleware that intercepts model or tool execution via handler callbacks. Both support optional state_schema, tools, and name parameters. The decorated function receives the request and handler, can call handler multiple times for retry logic, skip handler to short-circuit, or transform responses. Both sync and async variants are supported.",
      "evidence": [
