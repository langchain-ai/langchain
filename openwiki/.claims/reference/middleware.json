  "claims": [
    {
      "id": "claim_37a46b11c73844ac8d4d5ee6f2f737c6",
      "statement": "Agent middleware provides a composable, layered approach to intercepting and modifying agent behavior at well-defined execution points without changing core agent logic, with handlers registered for lifecycle hooks spanning initialization (before_agent), per-iteration model invocation (before_model, wrap_model_call, after_model), tool execution (wrap_tool_call), and completion (after_agent), composing by wrapping handlers in registration order to enable cross-cutting concerns such as automatic retries, error handling, human-in-the-loop approval, and request/response transformation.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py",
          "version": "repo-file-v1:sha256:cc4a7d9a620224558c4eddd4e13edc988a9ac9e328b7a67deeb71ed2c5ec5174"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py",
          "version": "repo-file-v1:sha256:56688206dce0334e7ca82125d7b809c23427890c234dfd69123dad038a387f31"
        }
      ]
    },
    {
      "id": "claim_a2679343b0b14ee682ff4a40009e05e8",
      "statement": "ModelRequest is an immutable dataclass that encapsulates all information needed for model invocation, including the model instance, messages, system message, tool choice, available tools, response format specification, agent state, runtime context, and model settings. It provides an override() method to create modified copies rather than supporting direct attribute mutation, which is deprecated.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L87-L269",
          "version": "repo-lines-v1:sha256:2e092d648db88d84598f61d1f81e0d629676c59f2cd9d2892492f2a466327fb3:"
        }
      ]
    },
    {
      "id": "claim_04521e84b10f4a63860ab83d0ae01b93",
      "statement": "ModelResponse is a generic dataclass encapsulating the result of model execution, containing a list of messages (typically one AIMessage) and an optional structured_response field for parsed structured output when response_format was specified.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L272-L287",
          "version": "repo-lines-v1:sha256:4b29b35e7cd99402231b6a07024efadb326a7c5048754fc1b27ace7a459970f7:"
        }
      ]
    },
    {
      "id": "claim_2f3c1ccb895c4c048c2346adb4f778ec",
      "statement": "ExtendedModelResponse pairs a ModelResponse with an optional LangGraph Command to enable middleware to apply additional state updates or control flow after the model node completes. Commands are applied through state reducers: messages are added to existing messages via add_messages reducer, while non-reducer state fields follow outermost-wins semantics where outer middleware values override inner ones.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L290-L325",
          "version": "repo-lines-v1:sha256:3c30d36312d3543408d371911614fc15118eaf34373c8d25f6d6fa64e1cb60fe:"
        }
      ]
    },
    {
      "id": "claim_f7995539ece14967a4c4fa5cf0d0cfbe",
      "statement": "AgentState is the core TypedDict state schema used by all agents, containing a Required messages field with add_messages reducer for accumulating messages, a NotRequired ephemeral jump_to field for control flow signals, and optional structured_response field for parsed output. Middleware can extend AgentState with custom fields via custom state schema declarations.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L349-L368",
          "version": "repo-lines-v1:sha256:6341ae8ca446ca57aee55bd0032315147777efbe4703f1942fb216a34a7534dd:"
        }
      ]
    },
    {
      "id": "claim_16ff636d3c1340a089a718d8de80751e",
      "statement": "OmitFromSchema annotations control whether state fields are exposed in input/output schemas. OmitFromInput and OmitFromOutput control individual exposure directions, while PrivateStateAttr marks fields as internal and omitted from both input and output schemas.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L328-L346",
          "version": "repo-lines-v1:sha256:665145dc4b8930ae32dc8cc6bb998a2693d1734dea585a8aedfe30280856e7ea:"
        }
      ]
    },
    {
      "id": "claim_edf90d9f83fb447194222bba46e47911",
      "statement": "Lifecycle hook decorators (@before_agent, @after_agent, @before_model, @after_model) dynamically create AgentMiddleware instances from functions. Each supports optional parameters: state_schema for custom state types, tools to register additional tools, can_jump_to to declare valid jump destinations, and name to customize the middleware class name. Both sync and async function variants are supported via automatic detection.",
