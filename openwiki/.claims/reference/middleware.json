    {
      "id": "claim_c960a9c6c6cc4529900a93d8406f13e4",
      "statement": "@dynamic_prompt is a convenience decorator for dynamically generating system prompts at runtime by intercepting wrap_model_call. The decorated function receives ModelRequest containing state and runtime context, returns a string or SystemMessage, and the decorator automatically integrates this as a system message override to the model request before invocation.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L1706-L1840",
