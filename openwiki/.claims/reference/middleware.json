        }
      ]
    },
    {
      "id": "claim_2b456bbade8346c98666eb494947d688",
      "statement": "JumpTo is a Literal type supporting control flow destinations: 'tools' jumps to tool execution, 'model' jumps back to model invocation, and 'end' exits the agent loop. Valid destinations must be declared via can_jump_to parameter in lifecycle hook decorators or @hook_config method decorator.",
      "evidence": [
