          "version": "repo-file-v1:sha256:a54d19d95dce38d27cc6920a5e05b6e1ebd4526d630d9bcf435a6a479d6edcca"
        }
      ]
    },
    {
      "id": "claim_bcfc0de1aef44484ace80da7774732f2",
      "statement": "LangChain provides convenience decorators (@before_agent, @after_agent, @before_model, @after_model, @wrap_model_call, @wrap_tool_call, @dynamic_prompt, @hook_config) that dynamically generate AgentMiddleware subclasses from plain functions at runtime, accepting parameters for state_schema, tools, can_jump_to (lifecycle hooks), and name, eliminating the need to manually subclass AgentMiddleware.",
