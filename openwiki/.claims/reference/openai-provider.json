  "claims": [
    {
      "id": "claim_6ed03c3da42e493bb141460b032fc3d8",
      "statement": "ChatOpenAI is a LangChain wrapper around OpenAI's Chat Completions and Responses APIs that targets official OpenAI API specifications only. It does not extract or preserve non-standard response fields added by third-party providers (e.g., reasoning_content, reasoning_details). For endpoints using custom provider fields, provider-specific LangChain packages (e.g., ChatDeepSeek, ChatOpenRouter) should be used instead.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1-L12",
          "version": "repo-lines-v1:sha256:14ebffc7bca9e6fda843b3932b482d6ffbf0487c1f74f9bfbb871bb591a6cbc1:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2929-L2940",
          "version": "repo-lines-v1:sha256:0f19bf46e3f6eba47bb09bcaf736fd464d54cb439977bb5226e88cfd09ad61b7:"
        }
      ]
    },
    {
      "id": "claim_fe4f384d5f9c4d08982048bfd7ebcad7",
      "statement": "BaseChatOpenAI provides shared OpenAI integration implementation extending BaseChatModel from langchain_core; ChatOpenAI extends BaseChatOpenAI and is the standard entry point for OpenAI's official APIs.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2928-L2928",
