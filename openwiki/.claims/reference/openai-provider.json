    {
      "id": "claim_5702390f697e4080a2afe34b0aa4d09b",
      "statement": "stream_chunk_timeout measures silence between parsed chunks (not inter-byte silence) for async streaming; distinct from httpx read timeout because OpenAI's SSE keepalive comments do not reset the timer; fires StreamChunkTimeoutError when stalled; defaults to 120s and is overridable via LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S environment variable.",
      "evidence": [
        {
