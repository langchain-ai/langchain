    {
      "id": "claim_4706f6eec7ed486fb9f35183dc721dbf",
      "statement": "ChatOpenAI base_url parameter resolution order is: explicit base_url kwarg, OPENAI_API_BASE environment variable, OPENAI_BASE_URL environment variable read by OpenAI SDK; when base_url is set, stream_usage defaults to False since non-OpenAI endpoints often do not support streaming token usage.",
