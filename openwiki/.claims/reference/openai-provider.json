    },
    {
      "id": "claim_6fd3e98a1d2949a6969c170fd86e866e",
      "statement": "ChatOpenAI automatically routes between Chat Completions and Responses APIs based on model name and configuration. When use_responses_api is None, routing is inferred from model prefix patterns and settings like reasoning, verbosity, and use_previous_response_id. Explicit use_responses_api parameter can override automatic inference.",
      "evidence": [
        {
