        }
      ]
    },
    {
      "id": "claim_c30fb9c5a73d41ae926e9b928ce74fee",
      "statement": "ChatOpenAI converts LangChain message types to OpenAI API format via _convert_message_to_dict(): HumanMessage to user role, AIMessage to assistant role with tool_calls, SystemMessage to system or developer role, ToolMessage to tool role, FunctionMessage to function role (legacy), ChatMessage to custom role; content is formatted per API with Chat Completions filtering tool_use/thinking/reasoning_content blocks.",
