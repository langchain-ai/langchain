    {
      "id": "claim_be808d8d6c9e489db8924692d7ee9525",
      "statement": "ChatOpenAI.with_structured_output() supports three methods for steering structured generation: 'json_schema' (OpenAI Structured Output API, most reliable), 'function_calling' (tool-calling API, legacy), and 'json_mode' (JSON mode, least reliable and requires prompt instructions). Strict mode ensures output matches schema exactly when supported.",
      "evidence": [
