    {
      "id": "claim_d798f3488a1f4f3d8df48b36cef0d514",
      "statement": "ChatOpenAI maps OpenAI SDK exceptions to LangChain standardized hierarchy: AuthenticationError to ModelAuthenticationError, PermissionDeniedError to ModelPermissionDeniedError, BadRequestError with context_length_exceeded to ContextOverflowError, BadRequestError with response_format validation to ModelInvalidRequestError, RateLimitError to ModelRateLimitError, NotFoundError to ModelNotFoundError, InternalServerError to ModelAPIError, APIConnectionError to ModelConnectionError, APITimeoutError to ModelTimeoutError.",
      "evidence": [
