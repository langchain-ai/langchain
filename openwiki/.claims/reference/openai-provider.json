    {
      "id": "claim_7176e927342f4eee9e8e84f84232922d",
      "statement": "ChatOpenAI streaming via stream() and astream() yields AIMessageChunk instances with partial content. stream_usage parameter controls whether usage metadata is included in final chunk; defaults to True for default base URL and OpenAI clients but is disabled when openai_api_base or custom http_client is set. Async streaming has configurable per-chunk timeout (stream_chunk_timeout, default 120s) via env var LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1105-L1145",
          "version": "repo-lines-v1:sha256:dfa0b175a318de71dd884ca5a2fd1d06c12bf1856ac21d6a05bf7f74e67b35d7:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L896-L911",
          "version": "repo-lines-v1:sha256:3810f01c423c020d0bad92e92a774d7abf76b18d1697e8cc1597db106a802fad:"
        }
      ]
    },
    {
      "id": "claim_b62937b31f604544a62b8e9a850c6798",
      "statement": "ChatOpenAI distinguishes between model_kwargs and extra_body: model_kwargs holds standard OpenAI API parameters (e.g., stream_options, max_completion_tokens, modalities) that are merged into the top-level request payload; extra_body holds custom parameters for OpenAI-compatible providers (vLLM, LM Studio) that are nested under the extra_body key. Using model_kwargs for non-OpenAI parameters causes API errors.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1150-L1169",
          "version": "repo-lines-v1:sha256:80082402cbabb980e06ddc23f0d280a10d2a35d2b9fce6ce36ed6df1bef1e0ff:"
        }
      ]
    },
    {
      "id": "claim_005acdd0a9894b929bfdf7c918429fdd",
      "statement": "ChatOpenAI enforces temperature constraints: o1 models default to temperature=1 if unset and require it; gpt-5 non-chat models only allow temperature=1 unless reasoning_effort='none' or reasoning={'effort': 'none'}. The validate_temperature model validator handles these constraints at initialization.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1354-L1384",
          "version": "repo-lines-v1:sha256:53b1aa5bdcce24d6da13312962e7b34db97824829e860c929ee90188dfc876be:"
        }
      ]
    },
    {
      "id": "claim_602db60212c649ab8c2146885c171af8",
      "statement": "For o-series models (matching pattern ^o\\d), ChatOpenAI automatically converts system messages from role='system' to role='developer' in request payloads, as required by these models' API specifications.",
