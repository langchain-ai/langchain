    },
    {
      "id": "claim_334f7fa44a9f46429a54ec80043a1212",
      "statement": "ChatOpenAI resolves authentication credentials in precedence order: explicit parameters override environment variables. For API keys: explicit api_key > OPENAI_API_KEY env var. For base URLs: explicit base_url > OPENAI_API_BASE > OPENAI_BASE_URL. API keys can be strings or sync/async callables; LangSmith gateway keys (prefix lsv2_) are detected for gateway routing.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1308-L1319",
          "version": "repo-lines-v1:sha256:f818c55d61a29e27a735e2886c9c8a076dd9f71f7a0b3497380cb1cfdcd6fc1f:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L814-L878",
          "version": "repo-lines-v1:sha256:788f5f2aedcfc06b24faf19692b3b570057e17a320cc920acad350aa29489cde:"
        }
      ]
    },
    {
      "id": "claim_a26478abb57e48f68730448ebee03fd7",
      "statement": "ChatOpenAI handles bidirectional message conversion: LangChain HumanMessage/AIMessage/SystemMessage/ToolMessage/FunctionMessage types map to OpenAI role formats (user/assistant/developer/tool/function). For o-series models, system messages are automatically converted to developer role. Tool calls in AIMessage are parsed from OpenAI's tool_calls field; invalid tool calls are collected separately.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1858-L1862",
          "version": "repo-lines-v1:sha256:216b588d7c6982cc9730275ce77bfc83ea5aa01af17b3622e86279e04ad61ed9:"
