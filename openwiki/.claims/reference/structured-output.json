          "version": "repo-file-v1:sha256:74590175ef1042dd8bd97f5c88a988b3818ef1e450eefd8f0ec67d7c6324fd2f"
        }
      ]
    },
    {
      "id": "claim_7d756cf0b96d4c5081e875cd7560f393",
      "statement": "ToolStrategy wraps a schema as an artificial tool, enforcing compliance through tool calling with configurable error handling via the handle_errors parameter, which supports boolean, string, exception type, exception tuple, or callable strategies to control retry behavior on validation failure.",
