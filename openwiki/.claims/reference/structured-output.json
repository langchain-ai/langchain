    {
      "id": "claim_302f5ebf43a74fb2a31f7614893cd310",
      "statement": "Structured output is a system mechanism that ensures a language model returns responses matching a specific JSON schema, with the agent supporting three strategies (tool-based, provider-native, and automatic) to enforce schema compliance, parse responses, validate against the schema using Pydantic's TypeAdapter, and automatically retry on validation errors.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py",
          "version": "repo-file-v1:sha256:22c48a3478de99dabb06b413085e0e388e74ddb3681bd9892a373faa757cf8fe"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/structured_output.py",
          "version": "repo-file-v1:sha256:5e608ab3d43fbe9b7867943a74cc8c07448307ea483a18352597e72870ae9eb4"
        }
      ]
    },
    {
      "id": "claim_7d756cf0b96d4c5081e875cd7560f393",
      "statement": "ToolStrategy wraps a schema as an artificial tool, enforcing compliance through tool calling with configurable error handling via the handle_errors parameter, which supports boolean, string, exception type, exception tuple, or callable strategies to control retry behavior on validation failure.",
      "evidence": [
