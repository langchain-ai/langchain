    {
      "id": "claim_56730c406df44e25b3a1a71934696e7b",
      "statement": "Parallel composition via dict literal or RunnableParallel invokes multiple Runnables with same input, collecting results into dict with user-specified keys. Execution is parallel via asyncio.gather (async) or ThreadPoolExecutor (sync). Respects max_concurrency config for concurrency control. Enables multi-branch processing patterns.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L3868-L3950",
          "version": "repo-lines-v1:sha256:0c5ab756654abd6e51d8bd513349e1bc045fc719e97bfccd6960407c94c1b2a7:"
        }
