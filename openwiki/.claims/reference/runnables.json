    {
      "id": "claim_ae0ff054a24d49048ba0eb954e7e0140",
      "statement": "The Runnable.astream_events(input, config=None, version='v2') method streams real-time structured events from chain execution including start/stream/end events for each component. Events include component name, run_id, parent_ids, tags, metadata, and event-specific data. Supports filtering by name, type, or tag. Version v2 (recommended) yields typed StreamEvent dicts and supports custom events.",
      "evidence": [
