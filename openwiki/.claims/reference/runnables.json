    {
      "id": "claim_acbcd1f919664d0f9302f9289208d23d",
      "statement": "Sequential composition via __or__(other) operator or pipe(*others) creates RunnableSequence where output of left side feeds into right side input. Operator automatically coerces non-Runnable arguments (callables, dicts, generators) via coerce_to_runnable() and flattens nested sequences. RunnableSequence optimizes batch and stream by calling each step's methods in order.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/runnables/base.py#L648-L722",
          "version": "repo-lines-v1:sha256:e4c79573c5218322918ea22f565b3065c04a3733a2671aad103990fc6a62b975:"
