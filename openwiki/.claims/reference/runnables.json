    },
    {
      "id": "claim_7f6ab56cfc3649c295c7d92d49c312d3",
      "statement": "The abatch method uses asyncio.gather with optional semaphore gating based on max_concurrency from config. If max_concurrency is not set or None, uses unlimited concurrency. Concurrency limit is derived from the first config item.",
      "evidence": [
