    {
      "id": "claim_512cac02a80c4852bcb63a3ea6031818",
      "statement": "ModelRequest follows an immutable pattern; direct attribute assignment is deprecated and raises DeprecationWarning; middleware must use request.override(**changes) to create a new request with modifications, preserving the original request.",
