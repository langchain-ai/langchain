    {
      "id": "claim_00e574d139f249e08fa25693fb5edff0",
      "statement": "Lifecycle hooks return optional state updates as dict[str, Any]; updates are merged using LangGraph reducer semantics—the messages field (with add_messages reducer) accumulates rather than replaces; non-reducer fields are overwritten by the most recent update.",
