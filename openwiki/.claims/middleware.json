        }
      ]
    },
    {
      "id": "claim_09073857a7004da38046987c8af77c7e",
      "statement": "AgentMiddleware defines optional lifecycle hooks: before_agent, after_agent, before_model, after_model, wrap_model_call, wrap_tool_call (and async variants); each middleware can implement any subset, with unimplemented methods raising NotImplementedError if called in the wrong execution path (sync vs async).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L385-L824",
          "version": "repo-lines-v1:sha256:1bca7c0dfb73b3e58a3b17221e416899e34920d00d8f54445e817652db30b813:"
        }
      ]
    },
    {
      "id": "claim_65c8d1db27b043c080d964a62daf2daa",
      "statement": "wrap_model_call receives a ModelRequest and handler callback; handler executes the model call and returns ModelResponse; middleware can call handler zero or more times for retry, caching, or fallback logic, or short-circuit with a custom result; returns ModelResponse, AIMessage (auto-wrapped to ModelResponse), or ExtendedModelResponse (with optional Command for state updates).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L290-L325",
          "version": "repo-lines-v1:sha256:3c30d36312d3543408d371911614fc15118eaf34373c8d25f6d6fa64e1cb60fe:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/types.py#L503-L585",
          "version": "repo-lines-v1:sha256:e2e85f065ac582ee3ff2cb0d26be437d93267a1340f230c025f69dbd634d5ef3:"
        }
      ]
    },
    {
      "id": "claim_97ac2b5a79b14505b9496b71d92f3c45",
      "statement": "wrap_tool_call receives a ToolCallRequest (with tool_call dict, BaseTool instance, state, and ToolRuntime) and handler callback; handler executes the tool call and returns ToolMessage or Command; middleware can call handler multiple times for retries, skip it entirely, or convert exceptions to error ToolMessages.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/middleware/tool_error.py#L37-L80",
          "version": "repo-lines-v1:sha256:cf892d6b28827271685f34985af1b0a9090677c06cdd90631a2e0e5e34f8cbc7:"
