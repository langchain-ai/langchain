    {
      "id": "claim_6ce968382a514edb90e74830ccdebef7",
      "statement": "Middleware registered first in the list becomes the outermost layer in the composition stack; in wrap_model_call and wrap_tool_call interception, outermost middleware receives control first and last, establishing a left-to-right composition where M1 wraps M2 which wraps M3.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/agents/factory.py#L263-L352",
          "version": "repo-lines-v1:sha256:272c0933c5414b8cecc2e64643c365fa65e76088a91d385cdab443f37076f035:"
        },
