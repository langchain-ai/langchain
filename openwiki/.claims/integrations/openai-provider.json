    {
      "id": "claim_20be828f848f4a75898f44017537a350",
      "statement": "ChatOpenAI and BaseChatOpenAI route requests between Chat Completions API (/v1/chat/completions) and Responses API (/v1/responses) based on model name, explicit use_responses_api parameter, and presence of advanced parameters (reasoning, context_management, include, truncation, store); Responses API is preferred for GPT-5+ series and models with features Chat Completions doesn't support; routing logic is in _use_responses_api() and _get_request_payload().",
      "evidence": [
