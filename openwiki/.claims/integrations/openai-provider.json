    {
      "id": "claim_bffcd0f293a04616a9c380c094c9ecc9",
      "statement": "with_structured_output() supports three methods: (1) 'function_calling' (default, uses tool-calling API, less strict, works with older models including GPT-3.5), (2) 'json_schema' (uses OpenAI's Structured Output API for guaranteed schema conformance, requires models supporting structured output like GPT-4 Turbo+, GPT-4o, gpt-5.x), (3) 'json_mode' (ensures JSON format output, no schema validation guarantee); supports include_raw to return both raw AIMessage and parsed output; strict parameter controls schema validation (True guarantees conformance when supported by method); tools parameter (json_schema only with strict=True and include_raw=True) allows tool invocation alongside structured output.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2616-L2878",
