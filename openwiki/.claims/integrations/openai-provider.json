    {
      "id": "claim_9be9727a947e4395a3b75b9bc4ca841f",
      "statement": "bind_tools() converts tools to OpenAI function schemas via convert_to_openai_tool() from langchain_core; supports Pydantic models, functions, BaseTool instances, and dicts; generates OpenAI-format function definitions with type, description, and parameters; handles tool_choice for model control (forcing specific tools, requiring any tool, or disabling tools) and parallel_tool_calls to enable/disable concurrent invocations; requires strict=True when response_format is provided in Chat Completions API.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2507-L2614",
          "version": "repo-lines-v1:sha256:e70e182b4ac97dbb31781e62b73610acaac7835e375a22824a9110daca3e7945:"
        }
      ]
    },
    {
      "id": "claim_a6a9e21061cf4a90915a361a104a581d",
      "statement": "with_structured_output() supports three methods: (1) 'json_schema' (default in ChatOpenAI, uses Structured Output API for guaranteed conformance), (2) 'function_calling' (uses tool-calling API, less strict, works with older models), (3) 'json_mode' (ensures JSON format, no schema guarantee); supports include_raw to return both raw AIMessage and parsed output; strict parameter controls schema validation; tools parameter (json_schema only, strict+include_raw required) allows tool invocation alongside structured output.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2616-L2878",
          "version": "repo-lines-v1:sha256:14c2acc8c738fb447b6995851743559e736d434f21245c843220309621afa05d:"
