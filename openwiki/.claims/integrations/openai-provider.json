    {
      "id": "claim_29fb03e4d8ba4f419c45f04e87e31d7c",
      "statement": "Vision support is transparent; images are passed as content blocks in HumanMessage with type='image_url' and url field (direct URLs or base64 data URLs); supported formats are JPEG, PNG, GIF, WebP; max 20 MB per image; OpenAI automatically rescales to 768x768 or applies smart cropping; integration does not pre-process images; multiple images in a single message are supported.",
      "evidence": [
