    {
      "id": "claim_ab6987caee654319b2e077003fb707f2",
      "statement": "LangChain messages are converted to OpenAI format via _convert_message_to_dict(), mapping HumanMessage→'user', AIMessage→'assistant', SystemMessage→'system' or 'developer' (based on __openai_role__ in additional_kwargs), ToolMessage→'tool', FunctionMessage→'function', and ChatMessage to custom role. Tool calls and function calls are extracted from AIMessage.tool_calls or additional_kwargs and formatted as OpenAI tool_calls or function_call dicts.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L218-L282",
          "version": "repo-lines-v1:sha256:adf75f5a37024e890e20a5b780ca4de846af6fa2f0ae26cbd5c286493e19ea04:"
