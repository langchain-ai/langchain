    {
      "id": "claim_5f27251c81d94eeb808c3efb3265abb5",
      "statement": "_stream() and _astream() set stream=True in payload and iterate over Server-Sent Events; each delta is converted to ChatGenerationChunk via _convert_chunk_to_generation_chunk(), which extracts role, content, tool_calls, and finish_reason; chunks are dispatched to run_manager.on_llm_new_token() callbacks; stream_usage enables token usage in streaming output (via stream_options={'include_usage': True}); async streams apply per-chunk timeout (stream_chunk_timeout, default 120s) to detect stalled connections.",
      "evidence": [
