          "version": "repo-lines-v1:sha256:4f37b02fe8bea277c794e5b3e72e4e4bd51a41ff1022cb3cee530a010157b073:"
        }
      ]
    },
    {
      "id": "claim_21382a8c8fa74dacbcb4b06374c71476",
      "statement": "OpenAI API key resolution follows a priority order: (1) explicit api_key parameter (string or callable), (2) environment variable OPENAI_API_KEY, (3) LangSmith Gateway when LANGSMITH_GATEWAY is set, (4) environment variable OPENAI_BASE_URL read by SDK; sync and async API keys are resolved separately to support callable keys that differ between sync/async contexts.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1404-L1461",
          "version": "repo-lines-v1:sha256:0a83eb2c632cea5e5aaff9f5728698b529ecf8bd3644072d7b124dd3b5a2ab9d:"
