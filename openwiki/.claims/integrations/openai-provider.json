    {
      "id": "claim_a77aa0fa1b8947a992ea8f75b054906f",
      "statement": "_format_message_content() processes message content blocks, converting text, images (from URLs and base64 data URLs), tool results, and audio blocks to OpenAI format; supports prompt cache breakpoints marked with 'prompt_cache_breakpoint' key, handles Anthropic-style image blocks with 'source' field, and normalizes audio replays to send only IDs (not data) in multi-turn conversations.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L285-L328",
