    {
      "id": "claim_bf7f54e6f0654726932e0b6f58b3af6d",
      "statement": "OpenAI exceptions are mapped to LangChain error taxonomy: openai.AuthenticationError→OpenAIAuthenticationError→ModelAuthenticationError, openai.RateLimitError→OpenAIRateLimitError→ModelRateLimitError, openai.NotFoundError→OpenAIModelNotFoundError, openai.BadRequestError (context_length)→OpenAIContextOverflowError→ContextOverflowError, openai.InternalServerError→OpenAIAPIError→ModelAPIError, openai.APIConnectionError→OpenAIConnectionError→ModelConnectionError, openai.APITimeoutError→OpenAITimeoutError→ModelTimeoutError; mapping occurs in _handle_openai_bad_request() and _handle_openai_api_error() called in _generate(), _stream(), _agenerate(), _astream().",
      "evidence": [
