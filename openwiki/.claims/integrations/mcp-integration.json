    {
      "id": "claim_ad7e86ddf5854463a1a7a683ec5330bd",
      "statement": "Converted MCP tools carry metadata under namespace 'mcp' containing tool-level annotations and _meta fields under mcp.tool and server identity/capabilities under mcp.server, enabling consumers to distinguish tool provenance and read tool-specific hints.",
