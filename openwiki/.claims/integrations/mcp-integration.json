  "claims": [
    {
      "id": "claim_7a8fafb1ebef428bb7a8123d6e1e4499",
      "statement": "MCPAdapter bridges MCP servers to LangChain agents by discovering tools from remote MCP servers, handling protocol negotiation via FastMCP, managing multiple transports (in-process, stdio, HTTP), routing calls to correct servers in multi-server setups, and answering mid-call user input via LangGraph interrupts.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/__init__.py",
          "version": "repo-file-v1:sha256:6f4fc76a2d1f0b2129e7598a5f4fd1bc05e389c9b98ad063d757baae27132e83"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L125-L172",
          "version": "repo-lines-v1:sha256:522fc669e156571f02b6a3683cd982f55d4ad22f3468f7b48e991a148877320e:"
        }
      ]
    },
    {
      "id": "claim_78d25bbe5e224e1c9db0eccc0c84e207",
      "statement": "MCP server lifecycle consists of five phases: (1) adapter initialization validates targets and arms the client for elicitation, (2) context entry connects the FastMCP client(s), (3) list_tools() fetches and converts remote tool definitions, (4) tools are executed asynchronously through the client, (5) context exit disconnects cleanly.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L174-L220",
          "version": "repo-lines-v1:sha256:13e59008e8c98131db014de7914f45245f03e65afdaf0c55289259d436c6d53c:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L221-L242",
          "version": "repo-lines-v1:sha256:8c8f286728fc9aa7955ce4e7a05920a6a04a6800acbb6d7e328ba2f703cef134:"
        }
      ]
    },
    {
      "id": "claim_30941d1be9f64060b3fce6ee2da38ba5",
      "statement": "MCPAdapter accepts multiple target types delegating transport inference to FastMCP: HTTP/HTTPS URL strings (with validation), Path objects (stdio subprocess), FastMCP instances (in-process), pre-built Client or ClientGroup (custom configuration), MCPConfig dict (multi-server), and ClientTransport (custom transport), with string targets validated to reject local file paths for security.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L174-L200",
          "version": "repo-lines-v1:sha256:a7c3a06c163bcf4e20d6e44446d36e8bb14135f5a0009971c6bd2341897814c6:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L47-L123",
          "version": "repo-lines-v1:sha256:ab1dc3462b418e9e717da86fbeb91a2a598c3bce4f1e0fa9386c3ab631b6a84a:"
        }
      ]
    },
    {
      "id": "claim_33009287ab8a477dad0deba1e0999a17",
      "statement": "MCP tools are converted to LangChain StructuredTool by as_langchain_tool(), which extracts name, description, and JSON schema from the MCP tool definition, creates an async coroutine that calls the tool through the client, sets response_format='content_and_artifact', attaches MCP metadata (tool annotations and server identity), and installs a custom error handler to surface tool-reported errors to the model.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/tools.py#L234-L304",
          "version": "repo-lines-v1:sha256:fce2dd0bf57a5f61654308ff25d42ba9d12733f5fe1b2ce344394adb108bdeab:"
        }
      ]
    },
    {
      "id": "claim_f44b7400ef8b4c18a0f909ec0961e6ed",
      "statement": "MCP result content blocks (TextContent, ImageContent, ResourceLink, EmbeddedResource) are converted to LangChain content blocks (text, image, file), with AudioContent not yet supported (raises NotImplementedError), and structured_content wrapped in MCPToolArtifact.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/tools.py#L120-L181",
          "version": "repo-lines-v1:sha256:0e3f074612917c8d40758869d2f765edae41b8e1bcc04573b80a3e98bf795dba:"
        }
      ]
    },
    {
      "id": "claim_c40ab952419347729692bd9062fd59e6",
      "statement": "Tool-reported errors (is_error=true) are converted to ToolMessage with status='error' carrying the server's error content, allowing the model to see and retry; transport and schema conversion errors propagate as exceptions since models cannot act on them.",
      "evidence": [
