    {
      "id": "claim_bcc61d46bd8645d7b5af6bd6dd4933ae",
      "statement": "MCP tool input schemas are normalized by _normalize_mcp_schema() to keep open object properties open during provider schema conversion: properties typed as 'object' with no properties, additionalProperties, or unevaluatedProperties constraints are marked with additionalProperties=true.",
