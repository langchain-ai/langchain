          "version": "repo-lines-v1:sha256:00595a74e7900f6282ec89125680c9f9451b6b85ce06c98654354276624d37c7:"
        }
      ]
    },
    {
      "id": "claim_d5941164a11b425bb890f35ca11fff7e",
      "statement": "MCP elicitation requests support two types: form requests asking for data matching a JSON schema, and URL requests asking user to visit a link (e.g., OAuth). Non-elicitation requests (sampling, roots) and continuation rounds (progress updates) are not supported by interrupt-driven elicitation.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/elicitation.py#L175-L192",
          "version": "repo-lines-v1:sha256:7db24099f60624a5bc45fccfbcc8b19b513b7173a4a54143fb5c340ed13fe6b3:"
        },
