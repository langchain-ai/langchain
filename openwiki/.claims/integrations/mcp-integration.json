        }
      ]
    },
    {
      "id": "claim_cfcd9af8396e46828fc8edfec7b31334",
      "statement": "MCP tool invocation follows request-response pattern: model generates tool call with arguments, agent executes async tool coroutine, tool calls server via FastMCP client, server returns CallToolResult with content blocks and optional structured content, adapter converts result to ToolMessage with content and artifact, model receives and processes response.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/tools.py#L283-L304",
          "version": "repo-lines-v1:sha256:131551a1a182eb465b7cd449c0da80d1b2ff90b5379ad3313f23249a69d99221:"
