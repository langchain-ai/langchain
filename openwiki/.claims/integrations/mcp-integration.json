        }
      ]
    },
    {
      "id": "claim_bf5f64d072d54e31a990d99d34f52b33",
      "statement": "When using ClientGroup or MCPConfig, tool names are prefixed by server key (e.g., 'weather_forecast' = 'weather' + 'forecast') to prevent collisions. Tool calls are routed to the correct server member via resolve_tool() which maps the namespaced tool name back to its member client and original upstream name.",
      "evidence": [
