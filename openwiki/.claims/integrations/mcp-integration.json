        }
      ]
    },
    {
      "id": "claim_e2048013a6154c72814e667782e7dd82",
      "statement": "Mid-call elicitation flow: server returns InputRequiredResult pausing execution, tool raises MCPElicitationInterrupt via langgraph.interrupt(), graph pauses and returns to human, reviewer submits MCPElicitationResume with answers, graph resumes and re-enters tool at interrupt point, tool forwards answers to server, server either returns terminal result or another InputRequiredResult (loop continues).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/elicitation.py#L312-L379",
          "version": "repo-lines-v1:sha256:05e3918e07f837ff89e0b8a1a2358fa3d060f8df483e23ddd3a37ca755128042:"
        }
      ]
    },
    {
      "id": "claim_930f64964215499bbf939f949644ce51",
      "statement": "MCPAdapter initialization arms each client for interrupt-driven elicitation by setting _elicitation_callback and stamping _langchain_mcp_interrupt_armed, honoring pre-built clients with custom handlers (not overriding), cloning clients before arming to avoid mutating caller's object, and cloning each member of a ClientGroup independently.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/mcp/adapter.py#L174-L200",
          "version": "repo-lines-v1:sha256:a7c3a06c163bcf4e20d6e44446d36e8bb14135f5a0009971c6bd2341897814c6:"
