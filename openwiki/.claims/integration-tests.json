  "claims": [
    {
      "id": "claim_2b394255185b4645a1dcf0e8c628a197",
      "statement": "VCR (Video Cassette Recorder) is the HTTP interaction recording and playback mechanism used in LangChain integration tests. Tests record live API interactions once with VCR, which scrubs sensitive headers and secrets before saving the cassette; subsequent runs replay cassettes instead of making live calls, enabling fast deterministic testing without credentials in CI.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/Makefile#L40-L43",
          "version": "repo-lines-v1:sha256:11e8869cd9ad3d186371833270e57f6b9b33e6bfb1fb7b21204584ccecc8bddf:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/conftest.py#L1-L249",
          "version": "repo-lines-v1:sha256:b85e00ecaa85790473365ec6ee983a68cac7244ca3be79b50cde32a75f250676:"
        },
        {
          "resource": "repo://libs/standard-tests/langchain_tests/conftest.py#L130-L143",
          "version": "repo-lines-v1:sha256:0144da3602191e08b1c7c3a3d0ea02abb6d35b5ffbf3a7e28f89554b904f1087:"
        }
      ]
    },
    {
      "id": "claim_500db96bd1a849b0bf87fcfc658df506",
      "statement": "Cassettes are stored in `tests/cassettes/` at the package root or in module-specific subdirectories like `tests/integration_tests/chat_models/cassettes/test_base/`. The `vcr_cassette_dir` fixture dynamically computes the correct cassette directory per test module.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/tests/integration_tests/conftest.py#L28-L33",
          "version": "repo-lines-v1:sha256:c07f93990d02fa5f77fa71acb95580ada8744a98c94f91d72e1381f0077d3147:"
        },
        {
