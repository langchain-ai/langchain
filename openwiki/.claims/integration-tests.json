    },
    {
      "id": "claim_3f784b2f297348b2ae4b083cd407a10e",
      "statement": "Cassettes are recorded once via `pytest --record-mode=new_episodes` with a valid API key in `.env`. VCR intercepts HTTP calls, scrubs sensitive data via before_record hooks, serializes to compressed YAML (.yaml.gz), and saves relative to the test module. Cassettes are committed to the repository and replayed in CI with --record-mode=none.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/Makefile#L35-L43",
          "version": "repo-lines-v1:sha256:fecf43d133a0b72243df932394549e0a5902eb879f7164c7eed7d6d2edadec63:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/conftest.py#L190-L204",
          "version": "repo-lines-v1:sha256:e1eddc5a41b085268d3db96f1152e60ae2dd6b69320f898d3da34980bdfbbe5d:"
        },
