          "version": "repo-lines-v1:sha256:178a83406b111cae8b9945220d636751deb8ed3bd88e5f84b74a590e38709789:"
        }
      ]
    },
    {
      "id": "claim_54d8ddd8a7164b23ad0b43dcda38d1b6",
      "statement": "LangChain scrubs sensitive data from cassettes before saving via multi-layer redaction: request/response headers (authorization, cookies, organization headers) are replaced with PLACEHOLDER; request/response bodies undergo recursive JSON parsing to redact OAuth secret fields (access_token, refresh_token, etc.) and JWT-shaped strings; binary payloads (PNG, JPEG, PDF) are skipped for performance since JWTs are ASCII.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/tests/conftest.py#L13-L163",
          "version": "repo-lines-v1:sha256:0585222ed51eed033d0d51b9e73183d4c7848ad754faa70ae3fc38813a59a6ca:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/conftest.py#L166-L187",
          "version": "repo-lines-v1:sha256:a1feed4edb565ee0f5aa60ad840e641a44ad15edc95a48b2bf44baab447eb762:"
        }
      ]
    },
    {
      "id": "claim_1cc580eab7d64d7f819732d066840145",
      "statement": "Integration tests load credentials from `.env` files (located at `tests/.env` or `tests/integration_tests/.env`) via `dotenv.load_dotenv()` in conftest on import. Tests access credentials via `os.environ[\"API_KEY\"]`. Tests without an API key in `.env` fail at runtime if they attempt to make live API calls, but cassette-backed tests run without credentials.",
      "evidence": [
        {
          "resource": "repo://libs/langchain/tests/integration_tests/.env.example#L1-L10",
          "version": "repo-lines-v1:sha256:7d2d09a71f21529ce791fb25eefc3b76ba0eb543269183caa8f2a08b5aefdb31:"
        },
        {
          "resource": "repo://libs/langchain_v1/tests/integration_tests/conftest.py#L1-L26",
          "version": "repo-lines-v1:sha256:061351d62d2c74fcabfd6e23faf1bac12b01a02fb00b7e9dd90279fec4dfcc06:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/integration_tests/chat_models/test_base.py#L47-L56",
          "version": "repo-lines-v1:sha256:da4d3e9908cb823935c901a1344645b98de1cfcb0f5c7a2ec32c29c6f594ce51:"
        }
      ]
    },
    {
      "id": "claim_91e6083fe38f4c06b675d1010d7577c7",
      "statement": "Integration tests use pytest markers to classify test types: @pytest.mark.vcr marks cassette-backed tests that replay recorded interactions (run in CI with --record-mode=none); @pytest.mark.scheduled marks live-API-only tests that are skipped in CI unless running in a scheduled workflow; unmarked tests are offline and don't require credentials.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/pyproject.toml#L141-L147",
          "version": "repo-lines-v1:sha256:f4860849b111f1c575475888e3d06804a8c2627ad1672362e56cb1f155ee634c:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/integration_tests/chat_models/test_base.py#L58-L78",
          "version": "repo-lines-v1:sha256:26638124d864750acfe43d1ed037e3ab197666170c26078a25a9055fce2c9342:"
        },
        {
