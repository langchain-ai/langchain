    {
      "id": "claim_f2f942acdaf344f8a7dd5232ded2f2d9",
      "statement": "VCR integration tests support both sync and async code; async tests use @pytest.mark.vcr and work identically to sync tests because VCR intercepts the underlying httpx/requests library. Streaming tests (via stream() or stream_events()) are fully supported; VCR records the stream sequence and replays it identically.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/tests/integration_tests/chat_models/test_base.py#L182-L200",
          "version": "repo-lines-v1:sha256:fafef0a13e0016604f3c165e8084f8715614912c9c36a21559ecaf8514dc10a7:"
        },
        {
          "resource": "repo://libs/partners/openai/tests/integration_tests/embeddings/test_base.py#L53-L65",
          "version": "repo-lines-v1:sha256:12ea5a2af5c6c9d1bc6c5d3b119a4244a7aa427067d71dbf77c3936af2c2c30d:"
        }
      ]
    },
    {
      "id": "claim_2b49d8e4a26b46658f273e50b4c1c2ed",
      "statement": "Each package's conftest.py extends base VCR configuration (from langchain_tests.conftest.base_vcr_config) via a vcr_config() fixture. Configuration includes record_mode (once/new_episodes/none), match_on strategy (method/uri/body or json_body for JSON-ignoring-order matching), filter_headers, before_record hooks, serializer (yaml.gz), and custom matchers registered in pytest_recording_configure().",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/tests/conftest.py#L190-L249",
          "version": "repo-lines-v1:sha256:cd6487781a7c4c4b6ded25db13dc8947476013ae99271f7d20a8d84bdb5faa01:"
        },
