    {
      "id": "claim_8f0d58bb96da44de9738527938034223",
      "statement": "ImagePromptTemplate is a BasePromptTemplate variant that formats dictionary templates containing image URLs and other fields using f-string, mustache, or jinja2 syntax. It validates that input_variables do not conflict with reserved fields (url, path, detail) and raises ValueError for local path loading.",
      "evidence": [
