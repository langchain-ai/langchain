    },
    {
      "id": "claim_d409c285b83a44afb2996c8b05f17e2a",
      "statement": "Prompts integrate with the Agent Factory (create_agent) via system_prompt parameter or ChatPromptTemplate construction. Middleware can intercept and modify prompts before model invocation using wrap_model_call hooks, enabling prompt optimization and safety filtering.",
