    },
    {
      "id": "claim_e9bf331f4444400c9f75560833e85a01",
      "statement": "All prompt templates inherit from RunnableSerializable, implementing invoke(dict)->PromptValue, ainvoke(dict)->PromptValue, batch(), and stream() methods. This enables prompts to be composed in chains using the pipe operator | and streamed for real-time output.",
