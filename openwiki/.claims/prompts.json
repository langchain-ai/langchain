  "claims": [
    {
      "id": "claim_06ad6af0140b4318b25f43272f89e77f",
      "statement": "LangChain provides two fundamental prompt types: PromptTemplate for single-string templates with variable substitution, and ChatPromptTemplate for sequences of typed messages with role-based formatting. Both support f-string, mustache, and jinja2 template engines.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L794-L900",
          "version": "repo-lines-v1:sha256:2a4cbd78ddd5acc97e3eb7f736bdf8617298512ce064c7184578afae27ccacbf:"
        },
        {
          "resource": "repo://libs/core/langchain_core/prompts/prompt.py#L24-L85",
          "version": "repo-lines-v1:sha256:dcbbf9653bb47f119dc44c8d556acb0d4abf35d335311fa1c789b88f77f894db:"
        }
      ]
    },
    {
      "id": "claim_927ac6a0c5cc4ef5ad98e2f754ef8053",
      "statement": "MessagesPlaceholder injects a pre-formatted list of messages at a specific position in a chat template, enabling conversation history management. The optional=True flag allows empty lists; n_messages limits message count for token budgeting.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L53-L217",
          "version": "repo-lines-v1:sha256:4c4592b99158ca55479cca728536ead0a34ce32c743c0416f002693e090ec08b:"
        }
      ]
    },
    {
      "id": "claim_faf16d09f30e4545a445406bfae52860",
      "statement": "Prompts support partial variable binding via partial_variables, which pre-fills template slots and reduces required inputs at format time. Partial application returns new immutable instances without mutating originals.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/base.py#L67-L72",
          "version": "repo-lines-v1:sha256:fab1c8777a008cb64f2a4a121a2b07880cc9622cf7c6c9794e34bf348551b8d1:"
        },
        {
          "resource": "repo://libs/core/langchain_core/prompts/prompt.py#L100-L125",
          "version": "repo-lines-v1:sha256:3f45cae3282d8d7c0693c92b033ec02c7d6f11880bef628ec50480c7060cd7d7:"
        }
      ]
    },
    {
      "id": "claim_2429fe3ccdcc43d39e2f12bc1e28ac30",
      "statement": "FewShotPromptTemplate combines a fixed or selected list of examples with a PromptTemplate for each example, a prefix, and suffix to create a single-string prompt. Example selection can be static (examples list) or dynamic (example_selector).",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/few_shot.py#L121-L239",
          "version": "repo-lines-v1:sha256:1ed2a3f7e9232ea7dbccea5421d1ca563040b6994765fc7dfdcda7126113e36d:"
        }
      ]
    },
    {
      "id": "claim_9b3c74b972a544aa8db493e82576b8ac",
      "statement": "FewShotChatMessagePromptTemplate embeds example message pairs within a chat template sequence. Each example is formatted as a conversation exchange (human/ai messages), then injected between prefix and suffix messages to teach models by demonstration.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/few_shot.py#L262-L416",
          "version": "repo-lines-v1:sha256:fdf87b1554c5d1a9a88cf12de0e7dd7f807add84226ec34c2bbeb8215ac0bdb4:"
        }
      ]
    },
    {
      "id": "claim_121fea6f1f0d48da88bcd9b3c01b5330",
      "statement": "BaseExampleSelector defines the interface for dynamic example selection, with add_example() to store examples and select_examples() to retrieve examples based on input variables. Async variants (aadd_example, aselect_examples) enable non-blocking selection.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/example_selectors/base.py#L9-L60",
          "version": "repo-lines-v1:sha256:ac0c16bb2bed71d11dad21892613c5fdc4b9b471d1af2bfc6edc3c03aa426903:"
        }
      ]
    },
    {
      "id": "claim_35528e0c2ce64233975c8faf77da10b4",
      "statement": "SemanticSimilarityExampleSelector embeds examples and inputs into a vector space using a VectorStore, retrieving the k most semantically similar examples. It supports filtering by input_keys and example_keys, and vectorstore_kwargs for custom similarity parameters.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/example_selectors/semantic_similarity.py#L101-L120",
          "version": "repo-lines-v1:sha256:2c9f66ff33dcf1094b0eab237586fb1f3ecaab439b42400bd1e63bbb3f1e9e5d:"
        }
      ]
    },
    {
      "id": "claim_dda62be78fb24ff98ee21ecd9cf79bb1",
      "statement": "LengthBasedExampleSelector greedily selects examples in order until adding the next example would exceed max_length (measured by get_text_length, defaulting to word count). This prevents prompt length overflow while maintaining insertion order.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/example_selectors/length_based.py#L18-L95",
          "version": "repo-lines-v1:sha256:67421df885a91f2a4c4f7c18484470621ec0b0b161c333821e431cb6d02724e8:"
        }
      ]
    },
    {
      "id": "claim_4e0168f92b0240508b33acfa82beeeec",
      "statement": "Prompts support three template engines: f-string (default, using Python syntax {var}), mustache (using {{var}}), and jinja2 (with conditionals and filters). Jinja2 uses SandboxedEnvironment to mitigate code execution risks from untrusted templates.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/prompt.py#L80-L87",
          "version": "repo-lines-v1:sha256:77fc2723831e2a68d0a7b23b0042fdbb13cc1a8689c9ca608037e78cf6eefac0:"
