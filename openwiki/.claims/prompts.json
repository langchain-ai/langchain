    },
    {
      "id": "claim_882a0fc6fcff41f7b9fee058ccc07ea2",
      "statement": "DictPromptTemplate applies variable substitution to string values in a dictionary structure, leaving keys and non-string values unchanged. It supports f-string and mustache formats (not jinja2) and recursively processes nested dicts.",
