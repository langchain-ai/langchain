    },
    {
      "id": "claim_3a55cd174caa4dab97afe198abe6c936",
      "statement": "ChatPromptTemplate supports role-based message construction via tuple shorthand syntax: ('system', ...), ('human', ...), ('ai', ...), and ('placeholder', ...) for MessagesPlaceholder. Full message classes like SystemMessage and HumanMessagePromptTemplate are also supported.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L794-L975",
          "version": "repo-lines-v1:sha256:13fad3baacc253afb555aecd6de3d603600a7bd0eb9c5d3b5418960f8ab2d442:"
        }
      ]
    },
    {
      "id": "claim_b9a41f4b9b684bc1983959d01e632d56",
      "statement": "ChatPromptTemplate automatically infers input_variables and optional_variables from messages during initialization. Optional MessagesPlaceholder instances are tracked separately and populated with empty lists as partial defaults.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L976-L1000",
