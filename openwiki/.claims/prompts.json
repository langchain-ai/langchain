    },
    {
      "id": "claim_466dc357eb8a48d5b7c341c5ca227fe6",
      "statement": "StructuredPrompt (beta) combines ChatPromptTemplate with a Pydantic schema, instructing models to produce JSON output matching the schema. This enables constrained output generation for tasks like fact extraction or data classification.",
