    {
      "id": "claim_9c170cb1d82e4c1396533adddef888b7",
      "statement": "Message templates support multimodal content combining text and images. HumanMessagePromptTemplate and AIMessagePromptTemplate accept lists mixing text strings with image-url dicts. Each image template can have at most one variable. The image_url value can be a string (for templating) or a dict with url and detail fields. Image loading from local paths is not supported for security reasons.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L400-L532",
