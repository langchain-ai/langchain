  "claims": [
    {
      "id": "claim_189e539212e149fdb6d26bfac3426a8c",
      "statement": "init_chat_model is a factory function that creates chat model instances from provider strings with optional prefixes (e.g., 'openai:gpt-4'), supporting both fixed and runtime-configurable model initialization modes. It centralizes instantiation across multiple provider integrations, handles provider inference, and routes parameters to provider-specific constructors.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L230-L240",
          "version": "repo-lines-v1:sha256:2cfac04a6db674cab340eadb38f47ef218a5f55df7f298a7b8342703a228272b:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L515-L529",
          "version": "repo-lines-v1:sha256:5c82190ce075e70f696f08fdf2ebfb113c6283ef02d77f557df3b93a6b354202:"
        }
      ]
    },
    {
      "id": "claim_df4133df06044486afe159623791dcc7",
      "statement": "init_chat_model accepts model (str or None), model_provider (str or None), configurable_fields (None, 'any', or list/tuple of field names), config_prefix (str or None), and **kwargs for provider-specific parameters. It returns either a BaseChatModel (fixed) or _ConfigurableModel (runtime-configurable).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L230-L237",
          "version": "repo-lines-v1:sha256:40f16a565f3062c4122d4e9125dd6ee970cd6047f1b144d1446dc683febfe94f:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L381-L386",
          "version": "repo-lines-v1:sha256:635fe4218d2ccfda31f2f659d7b3119e12d002612fdb21e3d1588084a6c4989f:"
        }
      ]
    },
    {
      "id": "claim_b02fe80251ae4429b2eadcadeede3569",
      "statement": "When a model string contains a colon and the prefix is a registered provider key, init_chat_model extracts the provider and model parts; otherwise it attempts best-effort inference from the model name prefix using case-insensitive matching against known patterns (gpt-, claude, command, amazon., etc.).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L543-L616",
          "version": "repo-lines-v1:sha256:a9fa9d961e85cbbccd7d57b4421babf5fbe5d93a7aa62b3bc0b38d6b368121dc:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L619-L648",
          "version": "repo-lines-v1:sha256:7ed3f3ed659bea78a63bacae1bc7cb6bc9fe0c7e7ec32215b6e5561ac495d752:"
        }
      ]
    },
    {
      "id": "claim_b11a1705a5cd44ea88dd0a9a4565a98d",
      "statement": "_BUILTIN_PROVIDERS is a dictionary mapping provider keys to tuples of (module_path, class_name, creator_func) for 37 built-in providers including openai, anthropic, bedrock, google_vertexai, azure_openai, cohere, groq, mistralai, ollama, and others. The registry includes fallback logic for ollama (tries langchain_community) and special creators for huggingface (from_model_id), ibm (model_id), and langsmith (gateway config).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L56-L120",
          "version": "repo-lines-v1:sha256:a714caf3bde31adb33a627fe7c985aa333571e5693027c2ef4131d0168cfc131:"
        }
      ]
    },
    {
      "id": "claim_8cf40321717f40ad867f7c85ceb2142d",
      "statement": "Most built-in providers use the standard _call creator function which directly instantiates the provider class. Special creators include: huggingface (uses from_model_id class method with model_id parameter), ibm (maps model to model_id constructor param), and langsmith (wraps instantiation with _apply_gateway_config to inject LangSmith gateway credentials and base URL from environment).",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L27-L38",
          "version": "repo-lines-v1:sha256:6e5b778f54e6269116c7c108fc0539dcb3d7f95e0e3529de1c59b46699e93250:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L51-L97",
          "version": "repo-lines-v1:sha256:fbbd5e179b2a760321d8bfaedb870aace34be1b417b6f3a4c3703a9a455bfa25:"
        }
      ]
    },
    {
      "id": "claim_52206704126944f1bc8bac7cea75f27d",
      "statement": "When model is a non-None string and configurable_fields is None (the default), init_chat_model immediately invokes _init_chat_model_helper to parse the model name, retrieve the provider's creator function, and instantiate the chat model with merged kwargs. The instantiated BaseChatModel is returned and ready for invoke/stream immediately.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L515-L520",
          "version": "repo-lines-v1:sha256:beb5925717f9dd1ecbc7d419ac81f59aeffd3a2ef9ba50313eb8edd82b89d904:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L532-L540",
          "version": "repo-lines-v1:sha256:85d94840b2951465740c4d8b5810394b3e5238bf6e32959da62a0e04828d3036:"
        }
      ]
    },
    {
      "id": "claim_1ad24cbf24204f71804126cdce8e0935",
      "statement": "_ConfigurableModel is a Runnable[LanguageModelInput, Any] that wraps init_chat_model when configurable_fields is not None or model is None. It queues model instantiation and declarative operations (bind_tools, with_structured_output) until invoke/stream is called with config, enabling runtime selection of model, provider, and parameters.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L521-L529",
          "version": "repo-lines-v1:sha256:34bcbfafa7789ef02b2356f9db768c3a24cc1a0e42628ec8caaf5f5396b4117d:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L657-L680",
          "version": "repo-lines-v1:sha256:bff10cdba27371d04116c8a459852b14f740b4919b6cbf369bb8f26ee2f76609:"
        }
      ]
    },
    {
      "id": "claim_9864f836752745aea729ecab9f689953",
      "statement": "_ConfigurableModel maintains _default_config (default params), _configurable_fields (which fields can override at runtime), _config_prefix (namespace for config keys), and _queued_declarative_operations (method calls to apply after model instantiation). On invoke/stream, _model(config) merges defaults with runtime config, instantiates the actual model via _init_chat_model_helper, applies queued operations, and delegates to the instantiated model.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L658-L680",
          "version": "repo-lines-v1:sha256:c6b92ea50d4c8f8413cd2b81f455be9be5ade4d21e15e834dd69bc36e0168f8c:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L711-L727",
          "version": "repo-lines-v1:sha256:208f58933e125c9b5eba0e1ba0a625f611d83d36672a257c931c33e375e84702:"
        }
      ]
    },
    {
      "id": "claim_22c8fb84fcbe4610a881583eb77e0000",
      "statement": "When bind_tools or with_structured_output are called on a _ConfigurableModel, __getattr__ intercepts these calls and queues the operation with its arguments instead of applying immediately. A new _ConfigurableModel is returned with the operation appended to _queued_declarative_operations, enabling chaining without mutating the original instance.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L681-L702",
          "version": "repo-lines-v1:sha256:176787c5900a0ecfbb77c7bcf291defe88731d7120a1477ebcf154902bdfcd18:"
        }
      ]
    },
    {
      "id": "claim_a78a74767aff40048a7c03b8beb81db0",
      "statement": "_model_params extracts model parameters from config['configurable'] with the config_prefix stripped, then filters to only whitelisted fields if _configurable_fields is a list (rather than 'any'). These are merged over _default_config to determine final instantiation parameters.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L718-L727",
          "version": "repo-lines-v1:sha256:c4374ce21b4f6fd5954ed1db71f666184e7bcb6ae57d42a2deadc3824c22e4fd:"
        }
      ]
    },
    {
      "id": "claim_2b7fd030bdd2424da9713d6f5d347b1d",
      "statement": "The langsmith provider bridges to LangSmith's unified LLM gateway. It uses _init_langsmith as the creator function, which calls _apply_gateway_config to read LANGSMITH_GATEWAY (default: https://gateway.smith.langchain.com) and LANGSMITH_GATEWAY_API_KEY/LANGSMITH_API_KEY environment variables, injecting them as openai_api_base and openai_api_key, then sets use_responses_api=True before returning a ChatOpenAI instance.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L27-L38",
          "version": "repo-lines-v1:sha256:6e5b778f54e6269116c7c108fc0539dcb3d7f95e0e3529de1c59b46699e93250:"
        },
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L85-L85",
          "version": "repo-lines-v1:sha256:7388d2845aa2a638c655dd1f452f3548453910726f6c46e285bea68cc344f7f1:"
        }
      ]
    },
    {
      "id": "claim_f40e3373b028465c9e4039fef1776032",
      "statement": "_import_module catches ImportError when importing a provider's integration package and raises an ImportError with a helpful message suggesting the pip package to install (e.g., 'pip install langchain-openai'). For ollama, it falls back to langchain_community.chat_models if langchain_ollama is not available.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L123-L192",
          "version": "repo-lines-v1:sha256:9a2a34a5d66d7b370be31f6393b3660e7b8a32212d987fca26bff006bf1d6e08:"
        }
      ]
    },
    {
      "id": "claim_349e633a7ed74c69adaf52964ad6aa7d",
      "statement": "_attempt_infer_model_provider uses case-insensitive prefix matching to infer provider from model name: gpt-/o1/o3/chatgpt/text-davinci → openai, claude → anthropic, command → cohere, accounts/fireworks → fireworks, amazon./anthropic./meta. → bedrock, gemini → google_vertexai (with deprecation warning), mistral/mixtral → mistralai, deepseek → deepseek, grok → xai, sonar → perplexity, solar → upstage. Returns None if no match, triggering a ValueError.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L543-L616",
          "version": "repo-lines-v1:sha256:a9fa9d961e85cbbccd7d57b4421babf5fbe5d93a7aa62b3bc0b38d6b368121dc:"
        }
      ]
    },
    {
      "id": "claim_dc1859b860ab4c1686802fd90b694c35",
      "statement": "If model is specified, configurable_fields defaults to None (no runtime configurability). If model is None, configurable_fields defaults to ('model', 'model_provider'), allowing runtime selection of both. If config_prefix is non-empty and configurable_fields is None or not provided, a warning is issued.",
      "evidence": [
        {
          "resource": "repo://libs/langchain_v1/langchain/chat_models/base.py#L504-L513",
          "version": "repo-lines-v1:sha256:a3a9526e612e846f52046efbcdc17fed68b4152d1ad0d02c9efc0b7336ff7a31:"
        }
      ]
    }
