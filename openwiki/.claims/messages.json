    {
      "id": "claim_d7b24c96a7074e02b52f395917200ee6",
      "statement": "ServerToolCall, ServerToolCallChunk, and ServerToolResult block types enable asynchronous tool execution. Models emit these blocks to request server-side execution (code execution, web search) without requiring local handler code, with the result encoded in a ServerToolResult block.",
      "evidence": [
