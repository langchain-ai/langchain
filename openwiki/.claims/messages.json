      ]
    },
    {
      "id": "claim_2567a2ede6c84547b9095834d2e2e3c3",
      "statement": "Each standard content block includes an optional extras field allowing provider-specific metadata (e.g., Google's thought_signature, Anthropic's cache_control) without breaking the standard structure. This enables supporting emerging provider capabilities while maintaining type safety.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/messages/content.py#L243-L244",
