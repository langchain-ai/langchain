    {
      "id": "claim_ce25a32acf814d4483932aa072d7748a",
      "statement": "FewShotChatMessagePromptTemplate embeds examples as message pairs within chat sequences. It uses an example_prompt ChatPromptTemplate to format each example as a sequence of messages, and can be embedded directly in a ChatPromptTemplate.from_messages() list alongside other message templates.",
