    {
      "id": "claim_b6007808e6e2431e92e89eefb62b8f58",
      "statement": "BasePromptTemplate extends RunnableSerializable, implementing invoke(), ainvoke(), batch(), and stream() methods. invoke() calls _format_prompt_with_error_handling() and returns PromptValue; metadata and tags are merged from the template into the runnable config before invocation. This enables prompts to compose seamlessly with models and output parsers via the | operator.",
      "evidence": [
        {
