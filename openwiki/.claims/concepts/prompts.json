    },
    {
      "id": "claim_4f7217a5f503469baa69c06f5ef4ab42",
      "statement": "ChatPromptTemplate sequences message templates into conversation structures, automatically inferring input_variables and optional_variables from embedded messages. When a ChatPromptTemplate has exactly one input variable, invoke() auto-wraps non-dict arguments. Message type strings ('system', 'human', 'ai', 'user', 'assistant', 'tool', 'function', 'placeholder') are mapped to specific message template classes.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/chat.py#L1-L52",
          "version": "repo-lines-v1:sha256:c2c36bf1f21ba4c79c77edcef1ee67cc7adacf5b4092337fd7d3ed03b34547b8:"
        }
      ]
    },
    {
      "id": "claim_693d3738d0f7407d930a994c0795322a",
      "statement": "MessagesPlaceholder injects pre-formatted message lists at specific points in chat prompts, supporting conversation history injection. It has fields optional (default False, allowing omission from inputs if True), n_messages (limiting recent messages), and input_variables that returns [variable_name] if not optional, [] if optional. Optional placeholders are auto-populated with [] as partial defaults.",
      "evidence": [
