    {
      "id": "claim_2744b97852c94bb9873ec92717376683",
      "statement": "BasePromptTemplate (in langchain_core.prompts.base) extends RunnableSerializable[dict[str, Any], PromptValue] and manages input validation, variable management, immutable composition, and PromptValue output routing. It enforces that input_variables and partial_variables do not overlap, and reserves the variable name 'stop' for internal use.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/base.py#L38-L106",
          "version": "repo-lines-v1:sha256:cb21cabaf35887c5a33bcc003d55152713d0ef71220e67ce5760c82164483d60:"
        }
      ]
    },
    {
      "id": "claim_4f5eb50c18b8473695e5fe3de687ec0f",
      "statement": "PromptTemplate supports three template formats: f-string (default, using Python string.Formatter), mustache (with {{variable}} syntax), and jinja2 (full templating with conditionals and filters). Jinja2 uses SandboxedEnvironment by default to block dunder attribute access, though sandboxing is best-effort. Template format validation and variable extraction differs per format.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/prompts/prompt.py#L77-L87",
          "version": "repo-lines-v1:sha256:059b15e048d8563bdc6a79f730f6abb19f69e5869ac24bab8b69fbdc7743b492:"
