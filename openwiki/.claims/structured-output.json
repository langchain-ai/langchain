    {
      "id": "claim_150a5dc8a9c14fc19c3597a746649ba0",
      "statement": "Structured output is a mechanism that constrains LLM responses to match a JSON schema, implemented via tool-based, provider-native, or automatically-detected strategies; parsing and validation occurs after model invocation via TypeAdapter or JSON deserialization.",
