    {
      "id": "claim_139468bfd71741bc8502700f319767ac",
      "statement": "Supported schema types are Pydantic BaseModel, dataclass, TypedDict, and raw JSON schema dict; _SchemaSpec normalizes these by extracting name/description and computing JSON Schema via TypeAdapter; dict schemas skip validation.",
