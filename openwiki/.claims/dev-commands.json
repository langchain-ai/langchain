    {
      "id": "claim_b27ba6d975ef4dd9b451d4443dd72b46",
      "statement": "Unit tests reside in tests/unit_tests/ and run with socket restrictions (--disable-socket --allow-unix-socket) to prevent accidental network calls. Integration tests in tests/integration_tests/ are run separately with full network access via make integration_tests.",
