    {
      "id": "claim_de10ca5a2875471db401124c306573ca",
      "statement": "Responses API supports conversation state reuse via previous_response_id parameter. ChatOpenAI can manage this automatically with use_previous_response_id=True, or manually by passing previous_response_id in invocation kwargs.",
