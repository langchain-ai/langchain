    },
    {
      "id": "claim_eb12b471a35f4b3aa689a29f4198b97d",
      "statement": "Base URL for API requests resolves in order: explicit base_url kwarg, OPENAI_API_BASE environment variable (read by LangChain), OPENAI_BASE_URL environment variable (read by OpenAI SDK). When base_url is set, stream_usage is disabled by default because many non-OpenAI endpoints don't support streaming token usage.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L792-L804",
          "version": "repo-lines-v1:sha256:9f9f2b6365c20f8e4ebc2ea1b16828d2dd71d68a1dd579ae1f9db0643b1c1207:"
        }
      ]
    },
    {
      "id": "claim_d7e278bba6bd44e9b618ca0d72f7cc6f",
      "statement": "ChatOpenAI.with_structured_output() supports three methods: 'function_calling' (tool-calling API, default), 'json_schema' (OpenAI Structured Output API for strict conformance), and 'json_mode' (JSON mode without strict schema validation).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2498-L2760",
          "version": "repo-lines-v1:sha256:14c2acc8c738fb447b6995851743559e736d434f21245c843220309621afa05d:"
        }
      ]
    },
    {
      "id": "claim_72e524b08caa4a60958af11e3c7b7090",
      "statement": "bind_tools() binds one or more tools to the model and accepts tool_choice parameter to specify 'auto', 'none', 'any'/'required', a tool name string, or a dict specifying which tool(s) to call. It also supports parallel_tool_calls, strict, and response_format parameters.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2390-L2496",
          "version": "repo-lines-v1:sha256:33e6d9ef74cf0bf4d7297bdd8e2c381cfac7bb645a908ab7e3175f00717700f6:"
        }
      ]
    },
    {
      "id": "claim_5c43c02cb87c4428a7bc56f79314828d",
      "statement": "tool_choice supports 'auto' (default), 'none' (prevent tool use), 'any'/'required'/True (force at least one call), a tool name string (force specific tool), and dict format for OpenAI's native tool choice specification.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2407-L2482",
          "version": "repo-lines-v1:sha256:fab7afcc3debe57067cfe831790e2c1f79ec95bbd1c9cbbd0616e6e8f94f59d0:"
        }
      ]
    },
    {
      "id": "claim_77569ef754954df2ba13220e12ac02fd",
      "statement": "The parallel_tool_calls parameter controls whether the model can call multiple tools in a single response. Defaults to None (allow parallel). Set to False to enforce sequential tool calls.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2421-L2422",
          "version": "repo-lines-v1:sha256:61eb411f416584d4ea4a194bb6e7cf28302d93bea6aa24ad3e60d1fd4d401fea:"
        }
      ]
    },
    {
      "id": "claim_53c99cf7136f4584ae5100e02b810a40",
      "statement": "Streaming output integrates with LangChain callbacks; on_llm_new_token() is invoked for each token chunk via run_manager, with per-chunk metadata passed to custom callback handlers.",
