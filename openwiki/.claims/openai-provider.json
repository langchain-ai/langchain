  "claims": [
    {
      "id": "claim_347664eb68464142b558791c7a95093f",
      "statement": "ChatOpenAI is the primary class in langchain-openai that wraps OpenAI's Chat Completions and Responses APIs, with support for structured output, tool calling, vision, streaming, and model profiles.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/__init__.py",
          "version": "repo-file-v1:sha256:d08e06dea1f954a477fa8951e2a8387a10396d07b92a3a60fdced307c136a84f"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2829-L3750",
          "version": "repo-lines-v1:sha256:d7750e52d840b4379fd892a656237cba6bf7af6d95a997b2485fb55d937139ec:"
        }
      ]
    },
    {
      "id": "claim_75e7343518fc437f8b13c59e87d5847d",
      "statement": "OpenAI API key can be provided as a string, sync callable, or async callable; if not provided, it is inferred from OPENAI_API_KEY environment variable.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L740-L790",
          "version": "repo-lines-v1:sha256:003a6dab73ea8fde5dc6459b1b513510f5f2edaf2d067675483617e4bbadc10c:"
        }
      ]
    },
    {
      "id": "claim_eb12b471a35f4b3aa689a29f4198b97d",
      "statement": "Base URL for API requests resolves in order: explicit base_url kwarg, OPENAI_API_BASE environment variable (read by LangChain), OPENAI_BASE_URL environment variable (read by OpenAI SDK). When base_url is set, stream_usage is disabled by default because many non-OpenAI endpoints don't support streaming token usage.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L792-L804",
          "version": "repo-lines-v1:sha256:9f9f2b6365c20f8e4ebc2ea1b16828d2dd71d68a1dd579ae1f9db0643b1c1207:"
        }
      ]
    },
    {
      "id": "claim_d7e278bba6bd44e9b618ca0d72f7cc6f",
      "statement": "ChatOpenAI.with_structured_output() supports three methods: 'function_calling' (tool-calling API, default), 'json_schema' (OpenAI Structured Output API for strict conformance), and 'json_mode' (JSON mode without strict schema validation).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2498-L2760",
          "version": "repo-lines-v1:sha256:14c2acc8c738fb447b6995851743559e736d434f21245c843220309621afa05d:"
        }
      ]
    },
    {
      "id": "claim_72e524b08caa4a60958af11e3c7b7090",
      "statement": "bind_tools() binds one or more tools to the model and accepts tool_choice parameter to specify 'auto', 'none', 'any'/'required', a tool name string, or a dict specifying which tool(s) to call. It also supports parallel_tool_calls, strict, and response_format parameters.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2413-L2505",
          "version": "repo-lines-v1:sha256:0b67e5cd29a887dca1b5eb6a2843d497c2e7bf8cae5c7138a79814c6c0bdaadc:"
        }
      ]
    },
    {
      "id": "claim_5c43c02cb87c4428a7bc56f79314828d",
      "statement": "tool_choice supports 'auto' (default), 'none' (prevent tool use), 'any'/'required'/True (force at least one call), a tool name string (force specific tool), WellKnownTools strings like 'file_search' and 'web_search' (built-in tools), and dict format for OpenAI's native tool choice specification.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2431-L2505",
          "version": "repo-lines-v1:sha256:39f452897ff3245da75c8a971b81a90b13d7a0c0dbc67d254f7600f1f66ebf89:"
        }
      ]
    },
    {
      "id": "claim_77569ef754954df2ba13220e12ac02fd",
      "statement": "The parallel_tool_calls parameter controls whether the model can call multiple tools in a single response. Defaults to None (allow parallel). Set to False to enforce sequential tool calls.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L2421-L2422",
          "version": "repo-lines-v1:sha256:61eb411f416584d4ea4a194bb6e7cf28302d93bea6aa24ad3e60d1fd4d401fea:"
        }
      ]
    },
    {
      "id": "claim_53c99cf7136f4584ae5100e02b810a40",
      "statement": "Streaming output integrates with LangChain callbacks; on_llm_new_token() is invoked for each token chunk via run_manager, with per-chunk metadata passed to custom callback handlers.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1647-L1649",
          "version": "repo-lines-v1:sha256:b19e7042c69c05d2f0b6b346fa80ca7ab0c988c98a431419568d5222a6992fcb:"
        }
      ]
    },
    {
      "id": "claim_edbede94a65146e0b8ff99588e7e2922",
      "statement": "stream_chunk_timeout is a per-chunk wall-clock timeout for async streaming (default 120 seconds); it measures silence between parsed chunks (not inter-byte silence), and can be disabled via LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S environment variable.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1010-L1050",
          "version": "repo-lines-v1:sha256:dfa0b175a318de71dd884ca5a2fd1d06c12bf1856ac21d6a05bf7f74e67b35d7:"
        }
      ]
    },
    {
      "id": "claim_86d1daa19cb746d9a2065da3c6b6ed5c",
      "statement": "Vision is supported on gpt-4-vision, gpt-4o, and gpt-4-turbo models; images can be provided via image_url with detail parameter ('low', 'high', 'auto') or as base64-encoded data URIs.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L4218-L4218",
          "version": "repo-lines-v1:sha256:3201e28b6cfd4728b55688cb7ad574d9f73a20f03afd7c969e7e1d597f5239cd:"
        }
      ]
    },
    {
      "id": "claim_9f2118c4389b49648e76c95402cdfb94",
      "statement": "Model profiles are auto-generated metadata stored in _profiles.py describing capabilities: text/image/audio/video inputs/outputs, max tokens, tool calling, structured output, tool_choice, and tool_call_streaming support.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/data/_profiles.py#L1-L20",
          "version": "repo-lines-v1:sha256:b97089e586471f63ae9446a5505aaf38d23261256a82aaf7f8979fce8fa7291b:"
        }
      ]
    },
    {
      "id": "claim_0deffbec52c948c1b753ce7204c5c114",
      "statement": "ChatOpenAI targets official OpenAI API specifications only; non-standard response fields added by third-party providers (e.g., reasoning_content, reasoning_details) are not extracted or preserved. For provider-specific features, use provider-specific packages (e.g., ChatDeepSeek, ChatOpenRouter).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1-L12",
          "version": "repo-lines-v1:sha256:14ebffc7bca9e6fda843b3932b482d6ffbf0487c1f74f9bfbb871bb591a6cbc1:"
        }
      ]
    },
    {
      "id": "claim_32bd96aa13d7497aaa57a1ab4854ffc7",
      "statement": "ChatOpenAI automatically switches between Chat Completions API and Responses API based on model name, parameters, and explicit configuration; Responses API is used when reasoning, context_management, truncation, include, or use_previous_response_id are specified, or when model name starts with 'gpt-5' (pro variants) or model is 'codex'.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1924-L1941",
          "version": "repo-lines-v1:sha256:3e78692a1e3b0ba179962add5d178415cd42ad5fcc7014aeb09f387a97cc53fd:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L704-L707",
          "version": "repo-lines-v1:sha256:82a296d139f47c53b4a1ab656ffeec75782c9412c8bc0365fa0ad828f8ddf817:"
        }
      ]
    },
    {
      "id": "claim_8c65009ac17447729064bb15abaa8729",
      "statement": "Responses API supports streaming reasoning for reasoning models, structured output with tools, context management via context_management parameter for automatic message compaction, truncation strategy control, and previous response tracking via use_previous_response_id for conversation continuity.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1206-L1241",
          "version": "repo-lines-v1:sha256:a8bb36529055ff53fdae31695bffcb6d5bc3944aeba5f9e75cf51a8a2d5e2ae5:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L909-L932",
          "version": "repo-lines-v1:sha256:41814211db4dd232ffa77a0d6d3398934a0d1c7d612c1624c73a8163939dfe23:"
        }
      ]
    },
    {
      "id": "claim_c741b92393a24960933927e07e430816",
      "statement": "ChatOpenAI maps OpenAI SDK exceptions to LangChain's standardized error hierarchy: AuthenticationError -> ModelAuthenticationError, PermissionDeniedError -> ModelPermissionDeniedError, BadRequestError (context_length_exceeded) -> ContextOverflowError, RateLimitError -> ModelRateLimitError, NotFoundError -> ModelNotFoundError, APIError -> ModelAPIError, APIConnectionError -> ModelConnectionError, APITimeoutError -> ModelTimeoutError.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L612-L677",
          "version": "repo-lines-v1:sha256:14658e6226d5972c8dfcd35ee5e68818fc2fb2d5615c55bf07435c5692bebb20:"
        }
      ]
    },
    {
      "id": "claim_526c35034a134a5ca6f38a2b9c1175fc",
      "statement": "Automatic retries for transient failures (429, 500-599) are configured via max_retries parameter; request timeout is controlled via timeout parameter (float or tuple of connect/read timeouts).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L816-L822",
          "version": "repo-lines-v1:sha256:718975f36eb81f71aeeb2c0f225af901bd7cd251b227e2763e704280a8354a24:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L841-L842",
          "version": "repo-lines-v1:sha256:926de5c3c86a9294d7224138eff3c672ec662e0c156f8f52da034baf6a183122:"
        }
      ]
    },
    {
      "id": "claim_8a2e099cfba141ab9fc85d0e16bc731d",
      "statement": "BaseChatOpenAI initialization resolves API authentication from parameters/environment variables/callables, builds HTTP clients (sync and async) with optional socket options, registers model profiles, validates parameters like stream_chunk_timeout, and initializes OpenAI client instances.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1254-L1259",
          "version": "repo-lines-v1:sha256:eb0e57bafb26e9cc000c8a15ea3591aeddc99ab35d2a64304d5224784a743455:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L715-L732",
          "version": "repo-lines-v1:sha256:4f37b02fe8bea277c794e5b3e72e4e4bd51a41ff1022cb3cee530a010157b073:"
        }
      ]
    },
    {
      "id": "claim_2fe26ad78d9648d88ef5c1ef3fa22b68",
      "statement": "When an async callable is provided for api_key, the sync client is not available; sync methods (invoke, stream) raise ValueError, requiring use of async methods (ainvoke, astream) instead.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L1605-L1613",
          "version": "repo-lines-v1:sha256:0d71a780173bd1a4489f6b543d90004f4d3f0f111d32814132308d89827f73a1:"
        }
      ]
    },
    {
      "id": "claim_80d965910e2d424f8526f864c8f3cb1d",
      "statement": "AzureChatOpenAI is a subclass of BaseChatOpenAI that inherits all ChatOpenAI functionality (tool calling, structured output, streaming, vision) but with Azure-specific authentication (azure_endpoint, api_key, azure_ad_token), endpoint routing via azure_deployment, and API versioning (api_version distinct from model version).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/azure.py#L37-L100",
          "version": "repo-lines-v1:sha256:1a48dd86b02b19c7a4b58181504f3e9226e1e3eaeb984873c284d04c5e2b013b:"
        }
      ]
    },
    {
      "id": "claim_fdcf536a8a03424185ad7ae6d5215610",
      "statement": "AzureChatOpenAI responses include Azure-specific metadata: prompt_filter_results and content_filter_results in response_metadata detailing content safety filtering for hate speech, self-harm, sexual content, and violence.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/azure.py#L152-L172",
          "version": "repo-lines-v1:sha256:5e8d741926523803a539f79ae153fb4a5ca0f627046ad21a15d2a63ee5f50519:"
        }
      ]
    },
    {
      "id": "claim_5636b23e82694eb7a7783e02d60452ab",
      "statement": "ChatOpenAI converts LangChain message types (HumanMessage, AIMessage, SystemMessage, ToolMessage) to OpenAI API format and back; output is AIMessage with content, tool_calls, invalid_tool_calls, additional_kwargs (audio, function_call), response_metadata (token usage, finish reason, system fingerprint, logprobs), and usage_metadata (standardized token counts).",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L217-L281",
          "version": "repo-lines-v1:sha256:adf75f5a37024e890e20a5b780ca4de846af6fa2f0ae26cbd5c286493e19ea04:"
        }
      ]
    },
    {
      "id": "claim_3caff63b9a194d83a4feca3784c64c79",
      "statement": "For multi-modal content, ChatOpenAI formats content blocks per API requirements; Chat Completions API filters certain block types (thinking, tool_use), while Responses API expands support for reasoning, computer use, file search.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L304-L326",
          "version": "repo-lines-v1:sha256:6cd902fc919094ac7918459a836e31a99d75d17d7ed2346180e909177edbf419:"
        },
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L329-L350",
          "version": "repo-lines-v1:sha256:8a2daaa3c8c8db699cb10fef0f8f2f525c09602dc0e497d7603c7d6aaaadb468:"
        }
      ]
    },
    {
      "id": "claim_da74740d79ff48be8b14b5d1660ccd31",
      "statement": "ChatOpenAI can be subclassed to customize behavior via overriding _generate, _stream, _agenerate, _astream methods; custom middleware can be added via RunnablePassthrough, RunnableLambda, or decorator patterns.",
      "evidence": [
        {
          "resource": "repo://libs/partners/openai/langchain_openai/chat_models/base.py#L715-L724",
          "version": "repo-lines-v1:sha256:4796c14704f049c8340f8cb74976a7f9e7af36bb8fbf9250e8c163d7a4124e0d:"
