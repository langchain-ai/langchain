    {
      "id": "claim_347664eb68464142b558791c7a95093f",
      "statement": "ChatOpenAI is the primary class in langchain-openai that wraps OpenAI's Chat Completions and Responses APIs, with support for structured output, tool calling, vision, streaming, and model profiles.",
