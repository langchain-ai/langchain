{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "label": "auto:release-pending",
  "release-label": "auto:release-tagged",
  "skip-github-release": true,
  "draft-pull-request": true,
  "separate-pull-requests": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverted Changes"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "hidden": true
    },
    {
      "type": "chore",
      "hidden": true
    },
    {
      "type": "refactor",
      "hidden": true
    },
    {
      "type": "test",
      "hidden": true
    },
    {
      "type": "ci",
      "hidden": true
    },
    {
      "type": "hotfix",
      "hidden": true
    }
  ],
  "pull-request-title-pattern": "release(${component}): ${version}",
  "component-no-space": true,
  "tag-separator": "==",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "versioning": "langchain",
  "pull-request-header": "> [!CAUTION]\n> Merging this PR will automatically publish to **PyPI** and create a **GitHub release**.\n\nReview the version and changelog before merging. See [the release process](https://github.com/langchain-ai/langchain/blob/master/.github/RELEASING.md).\n",
  "packages": {
    "libs/core": {
      "release-type": "python",
      "package-name": "langchain-core",
      "component": "langchain-core",
      "extra-files": [
        "pyproject.toml",
        "langchain_core/version.py"
      ],
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "libs/core/tests",
        "libs/core/uv.lock"
      ]
    },
    "libs/langchain": {
      "release-type": "python",
      "package-name": "langchain-classic",
      "component": "langchain-classic",
      "extra-files": [
        "pyproject.toml"
      ],
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "libs/langchain/tests",
        "libs/langchain/uv.lock"
      ]
    },
    "libs/langchain_v1": {
      "release-type": "python",
      "package-name": "langchain",
